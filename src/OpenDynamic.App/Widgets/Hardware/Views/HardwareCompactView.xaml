<UserControl x:Class="OpenDynamic.App.Widgets.Hardware.Views.HardwareCompactView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Height="36"
             Background="Transparent">
    <Grid VerticalAlignment="Center" Margin="14,0,14,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
            <!-- CPU Indicator -->
            <Path Data="M 2,2 H 14 V 14 H 2 Z M 5,0 V 2 M 8,0 V 2 M 11,0 V 2 M 5,14 V 16 M 8,14 V 16 M 11,14 V 16 M 0,5 H 2 M 0,8 H 2 M 0,11 H 2 M 14,5 H 16 M 14,8 H 16 M 14,11 H 16 M 5,5 H 11 V 11 H 5 Z"
                  Stroke="#4CD964"
                  StrokeThickness="1.2"
                  Fill="#204CD964"
                  Width="12"
                  Height="12"
                  Stretch="Uniform"
                  VerticalAlignment="Center"
                  Margin="0,0,6,0" />

            <TextBlock Text="CPU"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="#8E8E93"
                       VerticalAlignment="Center"
                       Margin="0,0,3,0" />

            <TextBlock Text="{Binding CpuSummaryText}"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="#FFFFFF"
                       VerticalAlignment="Center"
                       Width="30" />

            <!-- Subtle Separator -->
            <Rectangle Width="1" Height="14" Fill="#38383A" Margin="6,0,10,0" VerticalAlignment="Center" />

            <!-- RAM Indicator -->
            <Path Data="M 1,4 H 15 V 12 H 1 Z M 4,4 V 7 M 7,4 V 7 M 10,4 V 7 M 13,4 V 7 M 3,12 V 14 M 5,12 V 14 M 7,12 V 14 M 9,12 V 14 M 11,12 V 14 M 13,12 V 14"
                  Stroke="#5E5CE6"
                  StrokeThickness="1.2"
                  Fill="#205E5CE6"
                  Width="12"
                  Height="12"
                  Stretch="Uniform"
                  VerticalAlignment="Center"
                  Margin="0,0,6,0" />

            <TextBlock Text="RAM"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="#8E8E93"
                       VerticalAlignment="Center"
                       Margin="0,0,3,0" />

            <TextBlock Text="{Binding RamSummaryText}"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="#FFFFFF"
                       VerticalAlignment="Center"
                       Width="30" />
        </StackPanel>
    </Grid>
</UserControl>
