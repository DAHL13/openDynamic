<UserControl x:Class="OpenDynamic.App.Widgets.Hardware.Views.HardwareExpandedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Width="320"
             Background="Transparent">
    <UserControl.Resources>
        <!-- Flat, theme-independent ProgressBar Style honoring Foreground, rounded pill corners, and custom height -->
        <Style x:Key="HardwareProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Background" Value="#2C2C2E" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="PART_Track" ClipToBounds="True">
                            <!-- Track Background -->
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="2"
                                    Height="4" />
                            <!-- Progress Fill Indicator -->
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="2"
                                    Height="4" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="18,12,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Rendimiento del Sistema"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#8E8E93"
                       VerticalAlignment="Center" />
            <TextBlock Text="0% CPU en reposo"
                       FontSize="10"
                       Foreground="#4CD964"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center" />
        </DockPanel>

        <!-- Metric Cards -->
        <UniformGrid Grid.Row="1" Columns="2">
            <!-- CPU Card -->
            <Border Background="#1C1C1E" CornerRadius="10" Padding="12" Margin="0,0,6,0">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="CPU" FontSize="11" FontWeight="SemiBold" Foreground="#8E8E93" />
                        <TextBlock Text="{Binding CpuSummaryText}"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#4CD964"
                                   HorizontalAlignment="Right" />
                    </DockPanel>
                    <!-- Progress bar -->
                    <ProgressBar Style="{StaticResource HardwareProgressBarStyle}"
                                 Value="{Binding CpuUsagePercent, Mode=OneWay}"
                                 Foreground="#4CD964"
                                 Margin="0,0,0,4" />
                    <TextBlock Text="Carga de Procesador" FontSize="9" Foreground="#8E8E93" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <!-- RAM Card -->
            <Border Background="#1C1C1E" CornerRadius="10" Padding="12" Margin="6,0,0,0">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="MEMORIA" FontSize="11" FontWeight="SemiBold" Foreground="#8E8E93" />
                        <TextBlock Text="{Binding RamSummaryText}"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#5E5CE6"
                                   HorizontalAlignment="Right" />
                    </DockPanel>
                    <!-- Progress bar -->
                    <ProgressBar Style="{StaticResource HardwareProgressBarStyle}"
                                 Value="{Binding RamUsagePercent, Mode=OneWay}"
                                 Foreground="#5E5CE6"
                                 Margin="0,0,0,4" />
                    <TextBlock Text="{Binding MemoryUsageText}" FontSize="9" Foreground="#8E8E93" Margin="0,2,0,0" />
                </StackPanel>
            </Border>
        </UniformGrid>
    </Grid>
</UserControl>
