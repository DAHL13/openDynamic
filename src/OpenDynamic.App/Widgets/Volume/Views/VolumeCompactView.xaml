<UserControl x:Class="OpenDynamic.App.Widgets.Volume.Views.VolumeCompactView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:audio="clr-namespace:OpenDynamic.Core.Audio;assembly=OpenDynamic.Core"
             mc:Ignorable="d" 
             Height="36"
             Background="Transparent"
             PreviewMouseWheel="OnPreviewMouseWheel">
    <Grid Margin="12,0,12,0" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <!-- Speaker Icon -->
            <ColumnDefinition Width="Auto" />
            <!-- Volume Level Progress Bar -->
            <ColumnDefinition Width="*" />
            <!-- Percentage / Muted Text -->
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Speaker Icon -->
        <Border Grid.Column="0"
                Width="20"
                Height="20"
                Background="Transparent"
                Margin="0,0,8,0"
                VerticalAlignment="Center">
            <!-- Icon State Switcher -->
            <ContentControl Content="{Binding IconType}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <!-- High Volume (Default) -->
                        <Setter Property="ContentTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <Path Data="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"
                                          Fill="#FFFFFFFF"
                                          Stretch="Uniform"
                                          Width="15"
                                          Height="15" />
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <!-- Muted -->
                            <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <Path Data="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27l4.73 4.73H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"
                                                  Fill="#FFFF4D4D"
                                                  Stretch="Uniform"
                                                  Width="15"
                                                  Height="15" />
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <!-- Low Volume -->
                            <DataTrigger Binding="{Binding IconType}" Value="{x:Static audio:VolumeIconType.Low}">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <Path Data="M7 9v6h4l5 5V4L11 9H7z"
                                                  Fill="#E6FFFFFF"
                                                  Stretch="Uniform"
                                                  Width="14"
                                                  Height="14" />
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <!-- Medium Volume -->
                            <DataTrigger Binding="{Binding IconType}" Value="{x:Static audio:VolumeIconType.Medium}">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <Path Data="M18.5 12c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM5 9v6h4l5 5V4L9 9H5z"
                                                  Fill="#FFFFFFFF"
                                                  Stretch="Uniform"
                                                  Width="15"
                                                  Height="15" />
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </Border>

        <!-- Sleek Volume Progress Bar -->
        <ProgressBar Grid.Column="1"
                     Height="6"
                     Minimum="0"
                     Maximum="100"
                     Value="{Binding Percentage, Mode=OneWay}"
                     Margin="0,0,8,0"
                     VerticalAlignment="Center"
                     AutomationProperties.Name="Nivel de volumen maestro">
            <ProgressBar.Template>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <!-- Track Background -->
                        <Border Background="#33FFFFFF"
                                CornerRadius="3"
                                Height="6" />
                        <!-- Indicator Track -->
                        <Border x:Name="PART_Indicator"
                                HorizontalAlignment="Left"
                                CornerRadius="3"
                                Height="6">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FFFFFFFF" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                            <Setter Property="Background" Value="#88FFFFFF" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </ProgressBar.Template>
        </ProgressBar>

        <!-- Percentage / Muted Indicator (Polite live announcement) -->
        <TextBlock Grid.Column="2"
                   Text="{Binding StatusText}"
                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                   FontSize="11"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"
                   TextAlignment="Right"
                   MinWidth="28"
                   AutomationProperties.LiveSetting="Polite"
                   AutomationProperties.Name="Nivel de volumen" />
    </Grid>
</UserControl>
