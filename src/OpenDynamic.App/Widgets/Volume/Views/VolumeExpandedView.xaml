<UserControl x:Class="OpenDynamic.App.Widgets.Volume.Views.VolumeExpandedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:audio="clr-namespace:OpenDynamic.Core.Audio;assembly=OpenDynamic.Core"
             mc:Ignorable="d" 
             Width="390"
             Height="150"
             Background="Transparent"
             PreviewMouseWheel="OnPreviewMouseWheel">
    <Grid Margin="20,16,20,18">
        <Grid.RowDefinitions>
            <!-- Device Title -->
            <RowDefinition Height="Auto" />
            <!-- Slider & Visual Bar -->
            <RowDefinition Height="*" />
            <!-- Bottom Controls (Mute Button & Quick Step) -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: Device Name & Status -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Control de Volumen"
                           Foreground="{DynamicResource AppTextMutedBrush}"
                           FontSize="10"
                           FontWeight="Medium" />
                <TextBlock Text="{Binding DeviceName}"
                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           AutomationProperties.Name="{Binding DeviceName}" />
            </StackPanel>

            <TextBlock Grid.Column="1"
                       Text="{Binding StatusText}"
                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                       FontSize="20"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       AutomationProperties.LiveSetting="Polite"
                       AutomationProperties.Name="Porcentaje de volumen" />
        </Grid>

        <!-- Center: Interactive Slider / Bar -->
        <Grid Grid.Row="1" VerticalAlignment="Center" Margin="0,4,0,8">
            <Slider Minimum="0"
                    Maximum="100"
                    Value="{Binding Percentage, Mode=OneWay}"
                    ValueChanged="OnSliderValueChanged"
                    IsMoveToPointEnabled="True"
                    Focusable="False"
                    Cursor="Hand"
                    AutomationProperties.Name="Nivel de volumen maestro"
                    AutomationProperties.HelpText="Desliza para ajustar el volumen del sistema" />
        </Grid>

        <!-- Footer: Action Buttons -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Mute Toggle Button -->
            <Button Grid.Column="0"
                    Command="{Binding ToggleMuteCommand}"
                    Background="{DynamicResource AppControlBackgroundBrush}"
                    Foreground="{DynamicResource AppTextPrimaryBrush}"
                    BorderThickness="0"
                    Padding="14,6"
                    Cursor="Hand"
                    Focusable="False"
                    AutomationProperties.Name="Silenciar o reactivar sonido"
                    AutomationProperties.HelpText="Alterna el silencio del audio del sistema">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="14" />
                    </Style>
                </Button.Resources>
                <StackPanel Orientation="Horizontal">
                    <Path Stretch="Uniform"
                          Width="13"
                          Height="13"
                          Margin="0,0,6,0"
                          VerticalAlignment="Center">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Data" Value="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z" />
                                <Setter Property="Fill" Value="#FFFFFFFF" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                        <Setter Property="Data" Value="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27l4.73 4.73H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z" />
                                        <Setter Property="Fill" Value="#FFFF4D4D" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                    <TextBlock Text="{Binding MuteButtonText}"
                               FontSize="12"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <TextBlock Grid.Column="2"
                       Text="Rueda del ratón para ajustar"
                       Foreground="#66FFFFFF"
                       FontSize="10"
                       VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
