<UserControl x:Class="OpenDynamic.App.Widgets.EnergySaver.Views.EnergySaverSplitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Width="36"
             Height="36"
             Background="Transparent">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <!-- Circular Satellite Badge -->
        <Border Width="28"
                Height="28"
                CornerRadius="14"
                ClipToBounds="True"
                Background="#2630D158">
            <Path Data="M17 8C8 10 5.9 16.17 3.82 21.34l1.89.66.95-2.3c.48.17.98.3 1.34.3C19 20 22 3 22 3c-1 2-8 2.25-13 3.25S2 11.5 2 13.5s1.75 3.75 1.75 3.75C7 8 17 8 17 8z"
                  Stretch="Uniform"
                  Width="14"
                  Height="14"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
                <Path.Style>
                    <Style TargetType="Path">
                        <Setter Property="Fill" Value="#FF30D158" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEnergySaverOn}" Value="False">
                                <Setter Property="Fill" Value="#FF94A3B8" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Path.Style>
            </Path>
        </Border>
    </Grid>
</UserControl>
