<UserControl x:Class="OpenDynamic.App.Widgets.EnergySaver.Views.EnergySaverCompactView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Height="36"
             Background="Transparent">
    <Grid Margin="12,0,12,0" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <!-- Leaf / Eco Icon -->
            <ColumnDefinition Width="Auto" />
            <!-- Textual Details -->
            <ColumnDefinition Width="*" />
            <!-- Mode Indicator Badge -->
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Leaf / Energy Icon -->
        <Viewbox Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center" Width="18" Height="18" Stretch="Uniform">
            <Grid Width="24" Height="24">
                <!-- Eco Leaf Icon when On -->
                <Path Data="M17 8C8 10 5.9 16.17 3.82 21.34l1.89.66.95-2.3c.48.17.98.3 1.34.3C19 20 22 3 22 3c-1 2-8 2.25-13 3.25S2 11.5 2 13.5s1.75 3.75 1.75 3.75C7 8 17 8 17 8z"
                      Stretch="Uniform"
                      Width="22"
                      Height="22">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Fill" Value="#FF8E8E93" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEnergySaverOn}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Setter Property="Fill" Value="#FF30D158" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>

                <!-- Battery Restore Icon when Off -->
                <Path Data="M16 4h-2V2h-4v2H8C6.9 4 6 4.9 6 6v14c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H8V6h8v14zm-4.5-3l3.5-5.5h-2.5V8.5L9 14h2.5z"
                      Stretch="Uniform"
                      Width="20"
                      Height="20">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Fill" Value="#FF38BDF8" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEnergySaverOn}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Setter Property="Fill" Value="#FF94A3B8" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
            </Grid>
        </Viewbox>

        <!-- Textual Alert Details -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
            <TextBlock Text="{Binding Title}"
                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                       FontSize="10.5"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap"
                       AutomationProperties.LiveSetting="Polite"
                       AutomationProperties.Name="{Binding Title}" />
            <TextBlock Text="{Binding Subtitle}"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                       FontSize="9"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap"
                       AutomationProperties.Name="{Binding Subtitle}" />
        </StackPanel>

        <!-- Right Badge / Eco Dot -->
        <Border Grid.Column="2"
                CornerRadius="4"
                Padding="5,1.5"
                VerticalAlignment="Center">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#2230D158" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEnergySaverOn}" Value="False">
                            <Setter Property="Background" Value="#2294A3B8" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock FontSize="8.5" FontWeight="SemiBold">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="ECO" />
                        <Setter Property="Foreground" Value="#FF30D158" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEnergySaverOn}" Value="False">
                                <Setter Property="Text" Value="STD" />
                                <Setter Property="Foreground" Value="#FF94A3B8" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
