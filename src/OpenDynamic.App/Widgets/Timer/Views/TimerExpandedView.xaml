<UserControl x:Class="OpenDynamic.App.Widgets.Timer.Views.TimerExpandedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Width="330"
             Height="165"
             Background="Transparent">
    <!-- Balanced vertical margins with 14 DIP bottom clearance from the R:24 capsule curvature (similar to MediaExpandedView) -->
    <Grid Margin="18,10,18,14">
        <Grid.RowDefinitions>
            <!-- Mode Selector Segmented Bar -->
            <RowDefinition Height="Auto" />
            <!-- Big Countdown Clock -->
            <RowDefinition Height="Auto" />
            <!-- Progress Bar -->
            <RowDefinition Height="Auto" />
            <!-- Controls Row -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Mode Selector Segmented Bar -->
        <Border Grid.Row="0" Background="#1C1C1E" CornerRadius="8" Padding="2" HorizontalAlignment="Center" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <Button Content="Normal"
                        Command="{Binding SwitchToStandardCommand}"
                        Padding="8,3"
                        FontSize="9.5"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource AppTextPrimaryBrush}"
                        Background="{DynamicResource AppControlBackgroundBrush}"
                        BorderThickness="0"
                        Cursor="Hand"
                        AutomationProperties.Name="Modo temporizador normal" />
                <Button Content="Pomodoro (25m)"
                        Command="{Binding SwitchToPomodoroWorkCommand}"
                        Padding="8,3"
                        FontSize="9.5"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource AppTextPrimaryBrush}"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        AutomationProperties.Name="Modo Pomodoro trabajo 25 minutos" />
                <Button Content="Descanso (5m)"
                        Command="{Binding SwitchToPomodoroBreakCommand}"
                        Padding="8,3"
                        FontSize="9.5"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource AppTextPrimaryBrush}"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        AutomationProperties.Name="Modo Pomodoro descanso 5 minutos" />
            </StackPanel>
        </Border>

        <!-- Big Countdown Clock -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,4">
            <TextBlock Text="{Binding FormattedTime}"
                       FontSize="34"
                       FontWeight="Bold"
                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                       HorizontalAlignment="Center"
                       AutomationProperties.LiveSetting="Polite"
                       AutomationProperties.Name="Tiempo restante" />
            <TextBlock Text="{Binding ModeDescription}"
                       FontSize="10.5"
                       Foreground="{DynamicResource AppTextMutedBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,1,0,0" />
        </StackPanel>

        <!-- Progress Bar -->
        <Border Grid.Row="2" Height="4" Background="{DynamicResource AppControlBackgroundBrush}" CornerRadius="2" Margin="10,0,10,8">
            <ProgressBar Value="{Binding ProgressPercent}"
                         Minimum="0"
                         Maximum="100"
                         Height="4"
                         Foreground="{Binding StatusColorBrush}"
                         Background="Transparent"
                         BorderThickness="0"
                         AutomationProperties.Name="Progreso del temporizador" />
        </Border>

        <!-- Controls Row -->
        <Grid Grid.Row="3" Margin="10,0,10,0" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Quick Add Buttons -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="+1m"
                        Command="{Binding AddOneMinuteCommand}"
                        Padding="7,3"
                        FontSize="9.5"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource AppTextPrimaryBrush}"
                        Background="{DynamicResource AppControlBackgroundBrush}"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="0,0,4,0"
                        AutomationProperties.Name="Añadir 1 minuto" />
                <Button Content="+5m"
                        Command="{Binding AddFiveMinutesCommand}"
                        Padding="7,3"
                        FontSize="9.5"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource AppTextPrimaryBrush}"
                        Background="{DynamicResource AppControlBackgroundBrush}"
                        BorderThickness="0"
                        Cursor="Hand"
                        AutomationProperties.Name="Añadir 5 minutos" />
            </StackPanel>

            <!-- Play / Pause Action Button (100% visible, fully circular with safe clearance) -->
            <Button Grid.Column="1"
                    Command="{Binding TogglePlayPauseCommand}"
                    Width="36"
                    Height="36"
                    Background="{Binding StatusColorBrush}"
                    BorderThickness="0"
                    Cursor="Hand"
                    HorizontalAlignment="Center"
                    AutomationProperties.Name="Iniciar o pausar temporizador">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <Path Data="{Binding PlayPauseIconData}"
                      Fill="{DynamicResource AppAccentTextBrush}"
                      Width="14"
                      Height="14"
                      Stretch="Uniform"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
            </Button>

            <!-- Reset Button -->
            <Button Grid.Column="2"
                    Command="{Binding ResetCommand}"
                    Width="32"
                    Height="32"
                    Background="{DynamicResource AppControlBackgroundBrush}"
                    BorderThickness="0"
                    Cursor="Hand"
                    HorizontalAlignment="Right"
                    AutomationProperties.Name="Reiniciar temporizador">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <Path Data="M 12,4 A 8,8 0 1 0 16,10 M 16,4 V 10 H 10"
                      Stroke="{DynamicResource AppTextPrimaryBrush}"
                      StrokeThickness="1.5"
                      Fill="Transparent"
                      Width="12"
                      Height="12"
                      Stretch="Uniform"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
            </Button>
        </Grid>
    </Grid>
</UserControl>
