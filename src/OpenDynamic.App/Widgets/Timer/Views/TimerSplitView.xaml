<UserControl x:Class="OpenDynamic.App.Widgets.Timer.Views.TimerSplitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Width="36"
             Height="36"
             Background="Transparent">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Mini Clock Icon -->
            <Path Data="M 8,1 A 7,7 0 1 0 8,15 A 7,7 0 1 0 8,1 Z M 8,4 V 8 L 11,10"
                  Stroke="{Binding StatusColorBrush}"
                  StrokeThickness="1.2"
                  Fill="Transparent"
                  StrokeLineJoin="Round"
                  Width="10"
                  Height="10"
                  Stretch="Uniform"
                  HorizontalAlignment="Center"
                  Margin="0,0,0,1" />

            <!-- Satellite Compact Time Text -->
            <TextBlock Text="{Binding SatelliteTimeText}"
                       FontSize="8.5"
                       FontWeight="Bold"
                       Foreground="#FFFFFF"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
