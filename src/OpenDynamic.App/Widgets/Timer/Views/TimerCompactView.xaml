<UserControl x:Class="OpenDynamic.App.Widgets.Timer.Views.TimerCompactView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Height="36"
             Background="Transparent">
    <Grid VerticalAlignment="Center" Margin="14,0,14,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
            <!-- Timer Clock Icon -->
            <Path Data="M 8,1 A 7,7 0 1 0 8,15 A 7,7 0 1 0 8,1 Z M 8,4 V 8 L 11,10"
                  Stroke="{Binding StatusColorBrush}"
                  StrokeThickness="1.5"
                  Fill="Transparent"
                  StrokeLineJoin="Round"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  Width="14"
                  Height="14"
                  Stretch="Uniform"
                  VerticalAlignment="Center"
                  Margin="0,0,8,0"
                  AutomationProperties.Name="Icono de temporizador" />

            <!-- Mode Label (e.g. Work, Break) -->
            <TextBlock Text="{Binding ModeBadgeText}"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AppTextMutedBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,6,0"
                       Visibility="{Binding HasModeBadge, Converter={x:Null}}"
                       AutomationProperties.Name="{Binding ModeBadgeText}" />

            <!-- Remaining Time -->
            <TextBlock Text="{Binding FormattedTime}"
                       FontSize="13"
                       FontWeight="Bold"
                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                       VerticalAlignment="Center"
                       AutomationProperties.Name="Tiempo restante" />

            <!-- Expiration Alert Message (Polite live announcement for screen readers) -->
            <TextBlock Text="¡Terminado!"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="#FF453A"
                       VerticalAlignment="Center"
                       Margin="6,0,0,0"
                       Visibility="{Binding AlertBadgeVisibility}"
                       AutomationProperties.LiveSetting="Polite"
                       AutomationProperties.Name="Aviso de tiempo cumplido" />
        </StackPanel>
    </Grid>
</UserControl>
