<UserControl x:Class="OpenDynamic.App.Widgets.Stopwatch.Views.StopwatchExpandedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Width="330"
             Height="180"
             Background="Transparent">
    <Grid Margin="18,10,18,14">
        <Grid.RowDefinitions>
            <!-- Header Row -->
            <RowDefinition Height="Auto" />
            <!-- Big Clock Display -->
            <RowDefinition Height="Auto" />
            <!-- Controls Buttons -->
            <RowDefinition Height="Auto" />
            <!-- Laps History -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header Row -->
        <Grid Grid.Row="0" Margin="0,0,0,4">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Path Data="M 7,1 H 9 V 3 H 7 Z M 8,3 A 6.5,6.5 0 1 0 8,16 A 6.5,6.5 0 1 0 8,3 Z M 8,5 V 9.5 L 11,9.5 M 12.5,4.5 L 14,3"
                      Stroke="{Binding StatusColorBrush}"
                      StrokeThickness="1.5"
                      Fill="Transparent"
                      StrokeLineJoin="Round"
                      Width="12"
                      Height="12"
                      Stretch="Uniform"
                      VerticalAlignment="Center"
                      Margin="0,0,6,0" />
                <TextBlock Text="Cronómetro"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AppTextMutedBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Big Clock Display -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,6">
            <TextBlock Text="{Binding FormattedPrecise}"
                       FontSize="34"
                       FontWeight="Bold"
                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                       HorizontalAlignment="Center"
                       AutomationProperties.LiveSetting="Polite"
                       AutomationProperties.Name="Tiempo transcurrido en el cronómetro" />
            <TextBlock Text="{Binding FormattedCurrentLap, StringFormat='{}Vuelta actual: {0}'}"
                       FontSize="10.5"
                       Foreground="{DynamicResource AppTextMutedBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,1,0,0" />
        </StackPanel>

        <!-- Controls Buttons -->
        <Grid Grid.Row="2" Margin="0,0,0,8" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <!-- Lap Button -->
                <Button Content="Vuelta"
                        Command="{Binding LapCommand}"
                        IsEnabled="{Binding IsRunning}"
                        Padding="12,5"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource AppTextPrimaryBrush}"
                        Background="{DynamicResource AppControlBackgroundBrush}"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="0,0,8,0"
                        AutomationProperties.Name="Registrar vuelta en cronómetro" />

                <!-- Play / Pause / Resume Button -->
                <Button Command="{Binding TogglePlayPauseCommand}"
                        Padding="14,5"
                        FontSize="11"
                        FontWeight="Bold"
                        Foreground="#FFFFFF"
                        Background="{Binding StatusColorBrush}"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="0,0,8,0"
                        AutomationProperties.Name="{Binding PlayPauseButtonText}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{Binding PlayPauseIconData}"
                              Fill="#FFFFFF"
                              Width="10"
                              Height="10"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              Margin="0,0,5,0" />
                        <TextBlock Text="{Binding PlayPauseButtonText}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Reset Button -->
                <Button Content="Reiniciar"
                        Command="{Binding ResetCommand}"
                        Padding="12,5"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource AppTextPrimaryBrush}"
                        Background="{DynamicResource AppControlBackgroundBrush}"
                        BorderThickness="0"
                        Cursor="Hand"
                        AutomationProperties.Name="Reiniciar cronómetro a cero" />
            </StackPanel>
        </Grid>

        <!-- Laps History -->
        <Border Grid.Row="3"
                Background="#141416"
                CornerRadius="6"
                Padding="6,4"
                Margin="0,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding DisplayLaps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding LapNumber, StringFormat='{}V{0}'}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppTextMutedBrush}"
                                           Margin="0,0,10,0" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding FormattedLap, StringFormat='{}+{0}'}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                                           Margin="0,0,12,0" />
                                <TextBlock Grid.Column="3"
                                           Text="{Binding FormattedSplit}"
                                           FontSize="10"
                                           FontWeight="Normal"
                                           Foreground="{DynamicResource AppTextMutedBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
