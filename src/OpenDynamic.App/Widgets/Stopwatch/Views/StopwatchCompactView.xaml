<UserControl x:Class="OpenDynamic.App.Widgets.Stopwatch.Views.StopwatchCompactView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Height="36"
             Background="Transparent">
    <Grid VerticalAlignment="Center" Margin="14,0,14,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
            <!-- Stopwatch Icon -->
            <Path Data="M 7,1 H 9 V 3 H 7 Z M 8,3 A 6.5,6.5 0 1 0 8,16 A 6.5,6.5 0 1 0 8,3 Z M 8,5 V 9.5 L 11,9.5 M 12.5,4.5 L 14,3"
                  Stroke="{Binding StatusColorBrush}"
                  StrokeThickness="1.5"
                  Fill="Transparent"
                  StrokeLineJoin="Round"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  Width="14"
                  Height="14"
                  Stretch="Uniform"
                  VerticalAlignment="Center"
                  Margin="0,0,8,0"
                  AutomationProperties.Name="Icono de cronómetro" />

            <!-- Lap Badge if recorded -->
            <Border Background="#2C2C2E"
                    CornerRadius="4"
                    Padding="4,1"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    Visibility="{Binding HasLaps, Converter={x:Null}}">
                <TextBlock Text="{Binding LapCount, StringFormat='{}V{0}'}"
                           FontSize="9.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AppTextMutedBrush}" />
            </Border>

            <!-- Elapsed Time (mm:ss or mm:ss.cc) -->
            <TextBlock Text="{Binding FormattedTime}"
                       FontSize="13"
                       FontWeight="Bold"
                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                       VerticalAlignment="Center"
                       AutomationProperties.Name="Tiempo transcurrido del cronómetro" />
        </StackPanel>
    </Grid>
</UserControl>
