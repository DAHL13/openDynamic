<UserControl x:Class="OpenDynamic.App.Widgets.Privacy.Views.PrivacyExpandedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Focusable="False"
             Background="Transparent">
    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <!-- Header (Icon, Title, Subtitle) -->
            <RowDefinition Height="Auto" />
            <!-- Sensor Details Cards -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sensor Icon Badge -->
            <Border Grid.Column="0"
                    Width="32"
                    Height="32"
                    CornerRadius="16"
                    Margin="0,0,10,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#22FF9500" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCamera}" Value="True">
                                <Setter Property="Background" Value="#2234C759" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Viewbox Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Width="24" Height="24">
                        <Path Data="M12 14c1.66 0 3-1.34 3-3V5c0-1.66-1.34-3-3-3S9 3.34 9 5v6c0 1.66 1.34 3 3 3zm5-3c0 2.76-2.24 5-5 5s-5-2.24-5-5H5c0 3.53 2.61 6.43 6 6.92V21h2v-3.08c3.39-.49 6-3.39 6-6.92h-2z"
                              Fill="#FFFF9500">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMicrophone}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <Path Data="M12 9c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3zm0 4.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm7-7.5h-3.17L14.4 4.14C14.03 3.44 13.06 3 12.27 3h-2.54c-.79 0-1.76.44-2.13 1.14L6.17 6H3c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm0 12H3V8h3.88l1.64-3.14c.12-.23.49-.36.75-.36h2.54c.26 0 .63.13.75.36L14.12 8H19v10z"
                              Fill="#FF34C759">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCamera}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Grid>
                </Viewbox>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}"
                           Foreground="#FFFFFFFF"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Subtitle}"
                           Foreground="#99FFFFFF"
                           FontSize="11"
                           Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <!-- Sensor Status Summary Cards -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Microphone Card -->
            <Border Grid.Column="0"
                    Background="#15FFFFFF"
                    CornerRadius="8"
                    Padding="10,8,10,8">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Micrófono"
                                   Foreground="#CCFFFFFF"
                                   FontSize="11"
                                   FontWeight="SemiBold" />
                        <Ellipse HorizontalAlignment="Right"
                                 Width="6"
                                 Height="6"
                                 VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#44FFFFFF" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentState.IsMicrophoneActive}" Value="True">
                                            <Setter Property="Fill" Value="#FFFF9500" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding CurrentState.ActiveMicrophoneApps}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           Foreground="#FFFFFFFF"
                                           FontSize="10"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,1,0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Camera Card -->
            <Border Grid.Column="2"
                    Background="#15FFFFFF"
                    CornerRadius="8"
                    Padding="10,8,10,8">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Cámara"
                                   Foreground="#CCFFFFFF"
                                   FontSize="11"
                                   FontWeight="SemiBold" />
                        <Ellipse HorizontalAlignment="Right"
                                 Width="6"
                                 Height="6"
                                 VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#44FFFFFF" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentState.IsCameraActive}" Value="True">
                                            <Setter Property="Fill" Value="#FF34C759" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding CurrentState.ActiveCameraApps}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           Foreground="#FFFFFFFF"
                                           FontSize="10"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,1,0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
