<UserControl x:Class="OpenDynamic.App.Widgets.Network.Views.NetworkExpandedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Width="390"
             Height="150"
             Background="Transparent">
    <Grid Margin="20,16,20,18">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto" />
            <!-- Main Content Card -->
            <RowDefinition Height="*" />
            <!-- Status Info Footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Conexión de Red"
                       Foreground="#88FFFFFF"
                       FontSize="11"
                       FontWeight="Medium" />
        </Grid>

        <!-- Center: Icon & Network Info Card -->
        <Grid Grid.Row="1" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Large Network Icon Container -->
            <Border Grid.Column="0"
                    Width="48"
                    Height="48"
                    CornerRadius="24"
                    Margin="0,0,16,0"
                    VerticalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#2638BDF8" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                <Setter Property="Background" Value="#26EF4444" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="24" Height="24">
                    <!-- Wi-Fi Icon -->
                    <Path Data="M12 4C7.31 4 3.07 5.9 0 8.98L12 21 24 8.98C20.93 5.9 16.69 4 12 4zm0 3.5c3.78 0 7.22 1.48 9.77 3.9L12 18.25 2.23 11.4C4.78 8.98 8.22 7.5 12 7.5z"
                          Fill="#FF38BDF8"
                          Stretch="Uniform"
                          Width="22"
                          Height="18">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsConnected}" Value="True" />
                                            <Condition Binding="{Binding IsWiFi}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>

                    <!-- Ethernet Icon -->
                    <Path Data="M4 6h16v10H4V6zm2 2v6h12V8H6zm5 9h2v3h-2v-3z"
                          Fill="#FF38BDF8"
                          Stretch="Uniform"
                          Width="22"
                          Height="18">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsConnected}" Value="True" />
                                            <Condition Binding="{Binding IsEthernet}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>

                    <!-- Disconnected Icon -->
                    <Path Data="M2.28 3L1 4.28l3.11 3.11C2.5 8.35 1.15 9.61 0 11.08L12 23.1l4.9-4.9 4.82 4.82 1.28-1.28L2.28 3zM12 4C7.31 4 3.07 5.9 0 8.98l2.67 2.68C4.54 9.17 8.08 7.7 12 7.7c2.3 0 4.47.53 6.39 1.48l2.25-2.25C18.15 4.97 15.22 4 12 4z"
                          Fill="#FFEF4444"
                          Stretch="Uniform"
                          Width="22"
                          Height="18">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Grid>
            </Border>

            <!-- Network Text Info -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}"
                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           AutomationProperties.LiveSetting="Polite"
                           AutomationProperties.Name="{Binding Title}" />
                <TextBlock Text="{Binding Subtitle}"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                           FontSize="12"
                           Margin="0,4,0,0"
                           AutomationProperties.Name="{Binding Subtitle}" />
            </StackPanel>
        </Grid>

        <!-- Footer: Status indicator -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="8"
                        Height="8"
                        CornerRadius="4"
                        Margin="0,0,6,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#FF22C55E" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                    <Setter Property="Background" Value="#FFEF4444" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <TextBlock Foreground="#88FFFFFF"
                           FontSize="10">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Conexión a Internet establecida" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                    <Setter Property="Text" Value="Sin acceso a Internet ni red local" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
