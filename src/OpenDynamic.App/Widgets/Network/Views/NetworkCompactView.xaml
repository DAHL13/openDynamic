<UserControl x:Class="OpenDynamic.App.Widgets.Network.Views.NetworkCompactView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Height="36"
             Background="Transparent">
    <Grid Margin="12,0,12,0" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <!-- Network Icon -->
            <ColumnDefinition Width="Auto" />
            <!-- Text Details -->
            <ColumnDefinition Width="*" />
            <!-- Connection Status Dot -->
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Network Icon Column -->
        <Viewbox Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center" Width="18" Height="18" Stretch="Uniform">
            <Grid Width="24" Height="24">
                <!-- Wi-Fi Icon -->
                <Path Data="M12 4C7.31 4 3.07 5.9 0 8.98L12 21 24 8.98C20.93 5.9 16.69 4 12 4zm0 3.5c3.78 0 7.22 1.48 9.77 3.9L12 18.25 2.23 11.4C4.78 8.98 8.22 7.5 12 7.5z"
                      Fill="#FF38BDF8"
                      Stretch="Uniform"
                      Width="24"
                      Height="24">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsConnected}" Value="True" />
                                        <Condition Binding="{Binding IsWiFi}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>

                <!-- Ethernet Icon -->
                <Path Data="M4 6h16v10H4V6zm2 2v6h12V8H6zm5 9h2v3h-2v-3z"
                      Fill="#FF38BDF8"
                      Stretch="Uniform"
                      Width="24"
                      Height="24">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsConnected}" Value="True" />
                                        <Condition Binding="{Binding IsEthernet}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>

                <!-- Disconnected / No Network Icon -->
                <Path Data="M21 11l2-2c-3.73-3.73-8.87-5.15-13.7-4.31l2.58 2.58c3.3-.02 6.61 1.22 9.12 3.73m-2 2a9.9 9.9 0 0 0-3.72-2.33l3.02 3.02zM9 17l3 3l3-3a4.237 4.237 0 0 0-6 0M3.41 1.64L2 3.05L5.05 6.1C3.59 6.83 2.22 7.79 1 9l2 2c1.23-1.23 2.65-2.16 4.17-2.78l2.24 2.24A9.8 9.8 0 0 0 5 13l2 2a7 7 0 0 1 4.89-2.06l7.08 7.08l1.41-1.41z"
                      Fill="#FFEF4444"
                      Stretch="Uniform"
                      Width="24"
                      Height="24">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
            </Grid>
        </Viewbox>

        <!-- Text Details -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
            <TextBlock Text="{Binding Title}"
                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                       FontSize="10.5"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap"
                       AutomationProperties.LiveSetting="Polite"
                       AutomationProperties.Name="{Binding Title}" />
            <TextBlock Text="{Binding Subtitle}"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                       FontSize="9"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap"
                       AutomationProperties.Name="{Binding Subtitle}" />
        </StackPanel>

        <!-- Right Accent Status Dot -->
        <Grid Grid.Column="2" VerticalAlignment="Center">
            <Border Width="6"
                    Height="6"
                    CornerRadius="3"
                    Margin="2,0,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#FF22C55E" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                <Setter Property="Background" Value="#FFEF4444" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
        </Grid>
    </Grid>
</UserControl>
