<UserControl x:Class="OpenDynamic.App.Widgets.AgentApprovals.Views.ApprovalCompactView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Height="36"
             Background="Transparent">
    <Grid VerticalAlignment="Center" Margin="14,0,14,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
            <!-- Generic Agent Chip Icon (Geometric path, no 3rd party branding) -->
            <Path Data="M 4,2 L 12,2 L 14,6 L 14,12 L 12,14 L 4,14 L 2,12 L 2,6 Z M 5,7 A 1,1 0 1 0 5,9 A 1,1 0 1 0 5,7 Z M 11,7 A 1,1 0 1 0 11,9 A 1,1 0 1 0 11,7 Z M 6,11 L 10,11"
                  Stroke="{Binding RiskColorBrush}"
                  StrokeThickness="1.5"
                  Fill="Transparent"
                  StrokeLineJoin="Round"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  Width="14"
                  Height="14"
                  Stretch="Uniform"
                  VerticalAlignment="Center"
                  Margin="0,0,8,0"
                  AutomationProperties.Name="Icono de agente" />

            <!-- Title -->
            <TextBlock Text="Esperando aprobación"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,6,0" />

            <!-- Tool Name Badge -->
            <Border Background="{DynamicResource AppControlBackgroundBrush}" CornerRadius="4" Padding="5,1" VerticalAlignment="Center" Margin="0,0,6,0">
                <TextBlock Text="{Binding ToolDisplayName}"
                           FontSize="10"
                           FontWeight="Medium"
                           Foreground="{DynamicResource AppTextMutedBrush}" />
            </Border>

            <!-- Remaining Time Countdown -->
            <TextBlock Text="{Binding RemainingSecondsText}"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="{Binding RiskColorBrush}"
                       VerticalAlignment="Center"
                       AutomationProperties.Name="Tiempo restante de aprobación" />
        </StackPanel>
    </Grid>
</UserControl>
