<UserControl x:Class="OpenDynamic.App.Widgets.Screenshot.Views.ScreenshotCompactView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Height="36"
             Background="Transparent"
             MouseEnter="OnRootMouseEnter"
             MouseLeave="OnRootMouseLeave">
    <Grid Margin="10,0,10,0" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Left: Mini Thumbnail or Camera Icon -->
        <Grid Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center">
            <!-- Thumbnail Preview (when ShowScreenshotThumbnail is enabled and image is available) -->
            <Border Width="28"
                    Height="20"
                    CornerRadius="4"
                    ClipToBounds="True"
                    Background="#22FFFFFF"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Image Source="{Binding CurrentThumbnail}"
                       Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>

            <!-- Fallback Camera Icon (when thumbnail display is disabled in Settings) -->
            <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                <Viewbox.Style>
                    <Style TargetType="Viewbox">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Viewbox.Style>
                <Grid Width="24" Height="24">
                    <Path Data="M9 2L7.17 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2h-3.17L15 2H9zm3 15c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.65 0-3 1.35-3 3s1.35 3 3 3 3-1.35 3-3-1.35-3-3-3z"
                          Fill="#FF22D3EE"
                          Stretch="Uniform" />
                </Grid>
            </Viewbox>
        </Grid>

        <!-- Middle: Title & Metadata Subtitle -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
            <TextBlock Text="{Binding TransientTitle}"
                       Foreground="#FFFFFFFF"
                       FontSize="12"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding TransientSubtitle}"
                       Foreground="#AAFFFFFF"
                       FontSize="10"
                       FontWeight="Normal"
                       TextTrimming="CharacterEllipsis">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TransientSubtitle}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <!-- Right: Format Badge -->
        <Border Grid.Column="2"
                Background="#2606B6D4"
                CornerRadius="4"
                Padding="5,1,5,2"
                VerticalAlignment="Center">
            <TextBlock Text="{Binding CurrentExtensionBadge}"
                       Foreground="#FF22D3EE"
                       FontSize="9"
                       FontWeight="Bold" />
        </Border>
    </Grid>
</UserControl>
