<UserControl x:Class="OpenDynamic.App.Widgets.Screenshot.Views.ScreenshotExpandedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:screenshots="clr-namespace:OpenDynamic.Core.Screenshots;assembly=OpenDynamic.Core"
             mc:Ignorable="d"
             Width="392"
             Height="168"
             Focusable="False"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="ActionPillButtonStyle" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#1CFFFFFF" />
            <Setter Property="Foreground" Value="#F0FFFFFF" />
            <Setter Property="BorderBrush" Value="#24FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="0,0,5,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#30FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#40FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="14,10,14,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: Header -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Title & Badge -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Viewbox Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center">
                    <Path Data="M9 2L7.17 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2h-3.17L15 2H9zm3 15c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5z"
                          Fill="#FF22D3EE"
                          Stretch="Uniform" />
                </Viewbox>
                <TextBlock Text="Captura"
                           Foreground="#FFFFFFFF"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Border Margin="6,0,0,0"
                        Background="#2606B6D4"
                        CornerRadius="4"
                        Padding="5,1,5,2"
                        VerticalAlignment="Center">
                    <TextBlock Text="RAM"
                               Foreground="#FF22D3EE"
                               FontSize="9"
                               FontWeight="Bold" />
                </Border>
            </StackPanel>

            <!-- Feedback Banner -->
            <Border Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="8"
                    Padding="8,2,8,2"
                    Background="#3322C55E">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasFeedback}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding FeedbackMessage}"
                           Foreground="#FF4ADE80"
                           FontSize="10"
                           FontWeight="SemiBold" />
            </Border>

            <!-- Toggle History / Preview Button -->
            <Button Grid.Column="2"
                    Content="{Binding ModeToggleLabel}"
                    Click="OnToggleHistoryClick"
                    Focusable="False"
                    Cursor="Hand"
                    Foreground="#CC22D3EE"
                    Background="#1A06B6D4"
                    BorderBrush="#3306B6D4"
                    BorderThickness="1"
                    FontSize="10"
                    FontWeight="SemiBold"
                    Padding="7,2,7,2"
                    VerticalAlignment="Center">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- Row 1: Content Area -->
        <Grid Grid.Row="1">
            <!-- PANE A: Main Screenshot Preview & Actions -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsShowingPreview}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="146" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: Draggable Thumbnail Preview -->
                <Border x:Name="ThumbnailDragBorder"
                        Grid.Column="0"
                        Margin="0,0,12,0"
                        CornerRadius="8"
                        Background="#14FFFFFF"
                        BorderBrush="#2AFFFFFF"
                        BorderThickness="1"
                        ClipToBounds="True"
                        Cursor="SizeAll"
                        ToolTip="Arrastra esta miniatura hacia otra app para copiar el archivo"
                        PreviewMouseLeftButtonDown="OnThumbnailMouseLeftButtonDown"
                        PreviewMouseMove="OnThumbnailMouseMove">
                    <Grid>
                        <!-- Frozen Thumbnail Image -->
                        <Image Source="{Binding CurrentThumbnail}"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>

                        <!-- Fallback when thumbnail is disabled or unavailable -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Viewbox Width="24" Height="24" HorizontalAlignment="Center" Margin="0,0,0,4">
                                <Path Data="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"
                                      Fill="#66FFFFFF"
                                      Stretch="Uniform" />
                            </Viewbox>
                            <TextBlock Text="Vista previa"
                                       Foreground="#77FFFFFF"
                                       FontSize="9.5"
                                       HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Drag Copy Affordance Overlay -->
                        <Border VerticalAlignment="Bottom"
                                Background="#B3090D16"
                                Padding="4,2">
                            <TextBlock Text="Arrastrar para copiar"
                                       Foreground="#CCFFFFFF"
                                       FontSize="9"
                                       HorizontalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Right: File Metadata & Quick Actions -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Metadata Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock Text="{Binding CurrentFileName}"
                                   Foreground="#FFFFFFFF"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding CurrentMetadata}"
                                   Foreground="#99FFFFFF"
                                   FontSize="10"
                                   Margin="0,1,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- Step 0: Standard Quick Action Buttons -->
                    <UniformGrid Grid.Row="1" Columns="2" Rows="2" VerticalAlignment="Bottom">
                        <UniformGrid.Style>
                            <Style TargetType="UniformGrid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTrashStep0}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </UniformGrid.Style>

                        <Button Style="{StaticResource ActionPillButtonStyle}"
                                Background="#2606B6D4"
                                BorderBrush="#4406B6D4"
                                Foreground="#FF67E8F9"
                                Content="Copiar imagen"
                                Click="OnCopyImageClick" />

                        <Button Style="{StaticResource ActionPillButtonStyle}"
                                Content="Abrir"
                                Click="OnOpenImageClick" />

                        <Button Style="{StaticResource ActionPillButtonStyle}"
                                Content="En carpeta"
                                Click="OnRevealInFolderClick" />

                        <Button Content="Papelera"
                                Click="OnTrashStep1Click"
                                Background="#22EF4444"
                                BorderBrush="#44EF4444"
                                Foreground="#FFFCA5A5">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ActionPillButtonStyle}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTrashActionEnabled}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </UniformGrid>

                    <!-- Step 1: First Confirmation Prompt -->
                    <Border Grid.Row="1"
                            Background="#24F59E0B"
                            BorderBrush="#55F59E0B"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,5"
                            VerticalAlignment="Bottom">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTrashStep1}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="¿Enviar captura a la Papelera? (1/2)"
                                       Foreground="#FFFCD34D"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,5" />
                            <UniformGrid Columns="2">
                                <Button Style="{StaticResource ActionPillButtonStyle}"
                                        Margin="0,0,4,0"
                                        Padding="4,3"
                                        Background="#38F59E0B"
                                        BorderBrush="#66F59E0B"
                                        Foreground="#FFFDE68A"
                                        Content="Continuar"
                                        Click="OnTrashStep2Click" />
                                <Button Style="{StaticResource ActionPillButtonStyle}"
                                        Margin="4,0,0,0"
                                        Padding="4,3"
                                        Content="Cancelar"
                                        Click="OnCancelTrashClick" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Step 2: Second (Final) Confirmation Prompt -->
                    <Border Grid.Row="1"
                            Background="#28EF4444"
                            BorderBrush="#66EF4444"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,5"
                            VerticalAlignment="Bottom">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTrashStep2}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Confirmación final: ¿Reciclar archivo? (2/2)"
                                       Foreground="#FFFCA5A5"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,5" />
                            <UniformGrid Columns="2">
                                <Button Style="{StaticResource ActionPillButtonStyle}"
                                        Margin="0,0,4,0"
                                        Padding="4,3"
                                        Background="#48EF4444"
                                        BorderBrush="#88EF4444"
                                        Foreground="#FFFEE2E2"
                                        Content="Sí, reciclar"
                                        Click="OnConfirmRecycleClick" />
                                <Button Style="{StaticResource ActionPillButtonStyle}"
                                        Margin="4,0,0,0"
                                        Padding="4,3"
                                        Content="No"
                                        Click="OnCancelTrashClick" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- PANE B: Recent Screenshots History (up to 5 in memory) -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsShowingHistory}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <!-- Empty State -->
                <TextBlock Text="No hay capturas recientes en memoria"
                           Foreground="#66FFFFFF"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RecentItems.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Scrollable List of Last 5 Screenshots -->
                <ScrollViewer x:Name="HistoryScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Focusable="False"
                              PreviewMouseWheel="OnHistoryPreviewMouseWheel">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RecentItems.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>

                    <ItemsControl ItemsSource="{Binding RecentItems}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type screenshots:ScreenshotEntry}">
                                <Border Margin="0,0,4,4"
                                        Background="#15FFFFFF"
                                        BorderBrush="#1FFFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8,4,8,4"
                                        Cursor="Hand"
                                        MouseLeftButtonUp="OnHistoryItemClick">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- File Name & Metadata -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}"
                                                       Foreground="#E6FFFFFF"
                                                       FontSize="10.5"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding MetadataSummary}"
                                                       Foreground="#88FFFFFF"
                                                       FontSize="9.5"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <!-- Unavailable Badge -->
                                        <Border Grid.Column="1"
                                                Background="#28EF4444"
                                                CornerRadius="4"
                                                Padding="5,1,5,1"
                                                Margin="6,0,6,0"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="No disponible"
                                                       Foreground="#FFFCA5A5"
                                                       FontSize="9"
                                                       FontWeight="SemiBold" />
                                        </Border>

                                        <!-- Remove from History Button -->
                                        <Button Grid.Column="2"
                                                Content="Quitar"
                                                Click="OnRemoveHistoryItemClick"
                                                Focusable="False"
                                                Cursor="Hand"
                                                Background="#1FFFFFFF"
                                                Foreground="#BBFFFFFF"
                                                BorderThickness="0"
                                                FontSize="9.5"
                                                Padding="6,2,6,2"
                                                VerticalAlignment="Center">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="4"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
