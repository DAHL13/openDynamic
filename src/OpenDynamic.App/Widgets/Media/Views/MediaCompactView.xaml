<UserControl x:Class="OpenDynamic.App.Widgets.Media.Views.MediaCompactView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Height="36"
             Background="Transparent">
    <!-- 12 DIP horizontal margins protect content from the R:18 semicircular capsule edges -->
    <Grid Margin="12,0,12,0" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <!-- Thumbnail / Icon -->
            <ColumnDefinition Width="Auto" />
            <!-- Song & Artist Details -->
            <ColumnDefinition Width="*" />
            <!-- Audio Equalizer / Status Indicator -->
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Compact Album Artwork (20x20 with safe clearance from curved notch border) -->
        <Border Grid.Column="0"
                Width="20"
                Height="20"
                CornerRadius="5"
                ClipToBounds="True"
                Background="#22FFFFFF"
                Margin="0,0,7,0"
                VerticalAlignment="Center"
                AutomationProperties.Name="Carátula del álbum">
            <Grid>
                <!-- Fallback Note Icon when no thumbnail is provided -->
                <Path Data="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"
                      Fill="{DynamicResource AppTextPrimaryBrush}"
                      Stretch="Uniform"
                      Width="11"
                      Height="11"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Visibility="{Binding HasThumbnail, Converter={x:Null}}" />

                <!-- Frozen High Quality Album Cover -->
                <Image Source="{Binding Thumbnail}"
                       Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </Grid>
        </Border>

        <!-- Track Info with Ellipsis and Proper Breathing Room -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
            <TextBlock Text="{Binding TrackTitle}"
                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                       FontSize="10.5"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap"
                       AutomationProperties.Name="{Binding TrackTitle}" />
            <TextBlock Text="{Binding TrackArtist}"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                       FontSize="9"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap"
                       AutomationProperties.Name="{Binding TrackArtist}" />
        </StackPanel>

        <!-- Audio Spectrum Visualizer Bars (12 logarithmic bands in Compact view) -->
        <Border Grid.Column="2"
                VerticalAlignment="Center"
                Height="14"
                ClipToBounds="True"
                Visibility="{Binding EqualizerVisibility}"
                AutomationProperties.Name="Visualizador de espectro de audio">
            <StackPanel x:Name="CompactSpectrumPanel"
                        Orientation="Horizontal"
                        VerticalAlignment="Bottom"
                        Height="14">
                <Border x:Name="Bar0" Width="1.8" Height="3" CornerRadius="0.9" Background="{Binding AccentBrush, FallbackValue=#FFFFFFFF}" Margin="0,0,0.8,0" VerticalAlignment="Bottom" />
                <Border x:Name="Bar1" Width="1.8" Height="3" CornerRadius="0.9" Background="{Binding AccentBrush, FallbackValue=#FFFFFFFF}" Margin="0,0,0.8,0" VerticalAlignment="Bottom" />
                <Border x:Name="Bar2" Width="1.8" Height="3" CornerRadius="0.9" Background="{Binding AccentBrush, FallbackValue=#FFFFFFFF}" Margin="0,0,0.8,0" VerticalAlignment="Bottom" />
                <Border x:Name="Bar3" Width="1.8" Height="3" CornerRadius="0.9" Background="{Binding AccentBrush, FallbackValue=#FFFFFFFF}" Margin="0,0,0.8,0" VerticalAlignment="Bottom" />
                <Border x:Name="Bar4" Width="1.8" Height="3" CornerRadius="0.9" Background="{Binding AccentBrush, FallbackValue=#FFFFFFFF}" Margin="0,0,0.8,0" VerticalAlignment="Bottom" />
                <Border x:Name="Bar5" Width="1.8" Height="3" CornerRadius="0.9" Background="{Binding AccentBrush, FallbackValue=#FFFFFFFF}" Margin="0,0,0.8,0" VerticalAlignment="Bottom" />
                <Border x:Name="Bar6" Width="1.8" Height="3" CornerRadius="0.9" Background="{Binding AccentBrush, FallbackValue=#FFFFFFFF}" Margin="0,0,0.8,0" VerticalAlignment="Bottom" />
                <Border x:Name="Bar7" Width="1.8" Height="3" CornerRadius="0.9" Background="{Binding AccentBrush, FallbackValue=#FFFFFFFF}" Margin="0,0,0.8,0" VerticalAlignment="Bottom" />
                <Border x:Name="Bar8" Width="1.8" Height="3" CornerRadius="0.9" Background="{Binding AccentBrush, FallbackValue=#FFFFFFFF}" Margin="0,0,0.8,0" VerticalAlignment="Bottom" />
                <Border x:Name="Bar9" Width="1.8" Height="3" CornerRadius="0.9" Background="{Binding AccentBrush, FallbackValue=#FFFFFFFF}" Margin="0,0,0.8,0" VerticalAlignment="Bottom" />
                <Border x:Name="Bar10" Width="1.8" Height="3" CornerRadius="0.9" Background="{Binding AccentBrush, FallbackValue=#FFFFFFFF}" Margin="0,0,0.8,0" VerticalAlignment="Bottom" />
                <Border x:Name="Bar11" Width="1.8" Height="3" CornerRadius="0.9" Background="{Binding AccentBrush, FallbackValue=#FFFFFFFF}" VerticalAlignment="Bottom" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
