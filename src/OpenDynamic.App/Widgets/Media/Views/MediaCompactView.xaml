<UserControl x:Class="OpenDynamic.App.Widgets.Media.Views.MediaCompactView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Height="36"
             Background="Transparent">
    <Grid Margin="6,0,10,0" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <!-- Thumbnail / Icon -->
            <ColumnDefinition Width="Auto" />
            <!-- Song & Artist Details -->
            <ColumnDefinition Width="*" />
            <!-- Audio Equalizer / Status Indicator -->
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Thumbnail Container -->
        <Border Grid.Column="0"
                Width="24"
                Height="24"
                CornerRadius="6"
                ClipToBounds="True"
                Background="#22FFFFFF"
                Margin="0,0,8,0"
                VerticalAlignment="Center">
            <Grid>
                <!-- Fallback Note Icon when no thumbnail is provided -->
                <Path Data="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"
                      Fill="#B3FFFFFF"
                      Stretch="Uniform"
                      Width="12"
                      Height="12"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Visibility="{Binding HasThumbnail, Converter={x:Null}}" />

                <!-- Frozen High Quality Album Cover -->
                <Image Source="{Binding Thumbnail}"
                       Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </Grid>
        </Border>

        <!-- Track Info -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
            <TextBlock Text="{Binding TrackTitle}"
                       Foreground="#FFFFFFFF"
                       FontSize="11"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap" />
            <TextBlock Text="{Binding TrackArtist}"
                       Foreground="#FFAAAAAA"
                       FontSize="9.5"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap" />
        </StackPanel>

        <!-- Equalizer / Wave Bars -->
        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Height="14"
                    Width="16">
            <Border Width="2.5" Height="8" CornerRadius="1.2" Background="#FF1ED760" Margin="0,0,1.5,0" VerticalAlignment="Center" />
            <Border Width="2.5" Height="14" CornerRadius="1.2" Background="#FF1ED760" Margin="0,0,1.5,0" VerticalAlignment="Center" />
            <Border Width="2.5" Height="10" CornerRadius="1.2" Background="#FF1ED760" Margin="0,0,1.5,0" VerticalAlignment="Center" />
            <Border Width="2.5" Height="6" CornerRadius="1.2" Background="#FF1ED760" VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
