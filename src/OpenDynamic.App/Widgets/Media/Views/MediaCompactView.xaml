<UserControl x:Class="OpenDynamic.App.Widgets.Media.Views.MediaCompactView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Height="36"
             Background="Transparent">
    <!-- 12 DIP horizontal margins protect content from the R:18 semicircular capsule edges -->
    <Grid Margin="12,0,12,0" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <!-- Thumbnail / Icon -->
            <ColumnDefinition Width="Auto" />
            <!-- Song & Artist Details -->
            <ColumnDefinition Width="*" />
            <!-- Audio Equalizer / Status Indicator -->
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Compact Album Artwork (20x20 with safe clearance from curved notch border) -->
        <Border Grid.Column="0"
                Width="20"
                Height="20"
                CornerRadius="5"
                ClipToBounds="True"
                Background="#22FFFFFF"
                Margin="0,0,7,0"
                VerticalAlignment="Center">
            <Grid>
                <!-- Fallback Note Icon when no thumbnail is provided -->
                <Path Data="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"
                      Fill="#B3FFFFFF"
                      Stretch="Uniform"
                      Width="11"
                      Height="11"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Visibility="{Binding HasThumbnail, Converter={x:Null}}" />

                <!-- Frozen High Quality Album Cover -->
                <Image Source="{Binding Thumbnail}"
                       Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </Grid>
        </Border>

        <!-- Track Info with Ellipsis and Proper Breathing Room -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
            <TextBlock Text="{Binding TrackTitle}"
                       Foreground="#FFFFFFFF"
                       FontSize="10.5"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap" />
            <TextBlock Text="{Binding TrackArtist}"
                       Foreground="#FFAAAAAA"
                       FontSize="9"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap" />
        </StackPanel>

        <!-- Audio Equalizer Wave Bars (hidden in reduced motion mode) -->
        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Height="12"
                    Width="14"
                    Visibility="{Binding EqualizerVisibility}">
            <Border Width="2" Height="6" CornerRadius="1" Background="#FF1ED760" Margin="0,0,1.2,0" VerticalAlignment="Center" />
            <Border Width="2" Height="12" CornerRadius="1" Background="#FF1ED760" Margin="0,0,1.2,0" VerticalAlignment="Center" />
            <Border Width="2" Height="8" CornerRadius="1" Background="#FF1ED760" Margin="0,0,1.2,0" VerticalAlignment="Center" />
            <Border Width="2" Height="5" CornerRadius="1" Background="#FF1ED760" VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
