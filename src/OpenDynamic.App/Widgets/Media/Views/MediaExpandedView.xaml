<UserControl x:Class="OpenDynamic.App.Widgets.Media.Views.MediaExpandedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Width="390"
             Height="150"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="TransportButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="20"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#55FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="18,12,18,12">
        <Grid.RowDefinitions>
            <!-- Top Track Info & Thumbnail -->
            <RowDefinition Height="Auto" />
            <!-- Timeline & Progress Bar -->
            <RowDefinition Height="Auto" />
            <!-- Playback Controls -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Section: Thumbnail + Metadata -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Large Album Art -->
            <Border Grid.Column="0"
                    Width="52"
                    Height="52"
                    CornerRadius="10"
                    ClipToBounds="True"
                    Background="#2AFFFFFF"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center">
                <Grid>
                    <!-- Fallback Icon -->
                    <Path Data="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"
                          Fill="#88FFFFFF"
                          Stretch="Uniform"
                          Width="22"
                          Height="22"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                    <!-- Album Image -->
                    <Image Source="{Binding Thumbnail}"
                           Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Grid>
            </Border>

            <!-- Titles and Artists -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding TrackTitle}"
                           Foreground="#FFFFFFFF"
                           FontSize="14"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap" />
                <TextBlock Text="{Binding TrackArtist}"
                           Foreground="#FFCCCCCC"
                           FontSize="11.5"
                           Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap" />
                <TextBlock Text="{Binding TrackAlbum}"
                           Foreground="#FF888888"
                           FontSize="10"
                           Margin="0,1,0,0"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap" />
            </StackPanel>

            <!-- App Activation / Focus Button -->
            <Button Grid.Column="2"
                    Command="{Binding ActivateAppCommand}"
                    Style="{StaticResource TransportButtonStyle}"
                    ToolTip="Abrir reproductor en primer plano"
                    Width="32"
                    Height="32"
                    Padding="6"
                    VerticalAlignment="Top">
                <Path Data="M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z"
                      Fill="#B3FFFFFF"
                      Stretch="Uniform"
                      Width="14"
                      Height="14" />
            </Button>
        </Grid>

        <!-- Middle Section: Interactive Progress Slider -->
        <Grid Grid.Row="1" Margin="0,0,0,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Custom Interactive Seek Track -->
            <Border x:Name="ProgressBarContainer"
                    Grid.Row="0"
                    Height="12"
                    Background="Transparent"
                    Cursor="Hand"
                    MouseLeftButtonDown="OnProgressTrackClicked"
                    MouseMove="OnProgressTrackMouseMove">
                <Grid Height="4" VerticalAlignment="Center">
                    <!-- Background Track -->
                    <Border Background="#33FFFFFF" CornerRadius="2" />
                    <!-- Active Fill Track -->
                    <Border x:Name="ActiveProgressFill"
                            Background="#FFFFFFFF"
                            CornerRadius="2"
                            HorizontalAlignment="Left"
                            Width="0" />
                </Grid>
            </Border>

            <!-- Time Labels -->
            <Grid Grid.Row="1" Margin="0,2,0,0">
                <TextBlock Text="{Binding CurrentPositionFormatted}"
                           Foreground="#FF888888"
                           FontSize="10"
                           HorizontalAlignment="Left" />
                <TextBlock Text="{Binding DurationFormatted}"
                           Foreground="#FF888888"
                           FontSize="10"
                           HorizontalAlignment="Right" />
            </Grid>
        </Grid>

        <!-- Bottom Section: Playback Controls -->
        <Grid Grid.Row="2" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Previous Button -->
                <Button Command="{Binding SkipPreviousCommand}"
                        Style="{StaticResource TransportButtonStyle}"
                        Width="36"
                        Height="36"
                        Margin="0,0,16,0">
                    <Path Data="M6 6h2v12H6zm3.5 6l8.5 6V6z"
                          Fill="#FFFFFFFF"
                          Stretch="Uniform"
                          Width="16"
                          Height="16" />
                </Button>

                <!-- Play / Pause Button -->
                <Button Command="{Binding TogglePlayPauseCommand}"
                        Cursor="Hand"
                        Focusable="False"
                        Width="42"
                        Height="42">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="circleBorder"
                                    Width="42"
                                    Height="42"
                                    CornerRadius="21"
                                    Background="#FFFFFFFF">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- Play Icon (shown when paused) -->
                                    <Path x:Name="playPath"
                                          Data="M8 5v14l11-7z"
                                          Fill="#FF000000"
                                          Stretch="Uniform"
                                          Width="18"
                                          Height="18"
                                          Margin="2,0,0,0" />
                                    <!-- Pause Icon (shown when playing) -->
                                    <Path x:Name="pausePath"
                                          Data="M6 19h4V5H6v14zm8-14v14h4V5h-4z"
                                          Fill="#FF000000"
                                          Stretch="Uniform"
                                          Width="18"
                                          Height="18"
                                          Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                    <Setter TargetName="playPath" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="pausePath" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="circleBorder" Property="Background" Value="#FFE0E0E0" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="circleBorder" Property="Background" Value="#FFCCCCCC" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Next Button -->
                <Button Command="{Binding SkipNextCommand}"
                        Style="{StaticResource TransportButtonStyle}"
                        Width="36"
                        Height="36"
                        Margin="16,0,0,0">
                    <Path Data="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"
                          Fill="#FFFFFFFF"
                          Stretch="Uniform"
                          Width="16"
                          Height="16" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
