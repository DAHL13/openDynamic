<UserControl x:Class="OpenDynamic.App.Widgets.Clipboard.Views.ClipboardExpandedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:clipboard="clr-namespace:OpenDynamic.Core.Clipboard;assembly=OpenDynamic.Core"
             mc:Ignorable="d" 
             Width="390"
             Height="150"
             Focusable="False"
             Background="Transparent">
    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <!-- Header Row -->
            <RowDefinition Height="Auto" />
            <!-- History List Row -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Title & RAM Badge -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Portapapeles"
                           Foreground="#FFFFFFFF"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />

                <Border Margin="8,0,0,0"
                        Background="#26A855F7"
                        CornerRadius="4"
                        Padding="5,1,5,2"
                        VerticalAlignment="Center">
                    <TextBlock Text="Solo en RAM"
                               Foreground="#D8A855F7"
                               FontSize="9"
                               FontWeight="Bold" />
                </Border>
            </StackPanel>

            <!-- Feedback Message Banner -->
            <Border Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="10"
                    Padding="10,2,10,2"
                    Background="#3322C55E">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasFeedback}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding FeedbackMessage}"
                           Foreground="#4ADE80"
                           FontSize="10"
                           FontWeight="SemiBold" />
            </Border>

            <!-- Clear Button -->
            <Button Grid.Column="2"
                    Content="Borrar"
                    Focusable="False"
                    Click="OnClearClick"
                    Cursor="Hand"
                    Foreground="#88FFFFFF"
                    FontSize="11"
                    FontWeight="Medium"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="6,2,6,2"
                    VerticalAlignment="Center">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- History Items List Container -->
        <Grid Grid.Row="1">
            <!-- Empty State Notice -->
            <TextBlock Text="El historial en memoria está vacío"
                       Foreground="#66FFFFFF"
                       FontSize="11"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RecentItems.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Scrollable Items List -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RecentItems.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>

                <ItemsControl ItemsSource="{Binding RecentItems}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type clipboard:ClipboardItem}">
                            <!-- Item Card -->
                            <Border Margin="0,0,0,4"
                                    Background="#15FFFFFF"
                                    BorderBrush="#1AFFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,5,8,5"
                                    Cursor="Hand"
                                    Focusable="False"
                                    MouseLeftButtonUp="OnItemClick">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <!-- Kind Icon -->
                                        <ColumnDefinition Width="Auto" />
                                        <!-- Text Preview -->
                                        <ColumnDefinition Width="*" />
                                        <!-- Re-copy Affordance -->
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Category Icon -->
                                    <Viewbox Grid.Column="0" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Grid Width="20" Height="20">
                                            <!-- Text Kind -->
                                            <Path Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-2 10H7v-2h10v2zm0-4H7V7h10v2z"
                                                  Fill="#FFA855F7"
                                                  Stretch="Uniform" />
                                        </Grid>
                                    </Viewbox>

                                    <!-- Preview Text -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DisplayPreview}"
                                               Foreground="#E6FFFFFF"
                                               FontSize="11"
                                               FontWeight="Normal"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />

                                    <!-- Copy Action Hint -->
                                    <TextBlock Grid.Column="2"
                                               Text="Copiar"
                                               Foreground="#88A855F7"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
