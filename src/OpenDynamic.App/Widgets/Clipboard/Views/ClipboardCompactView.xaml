<UserControl x:Class="OpenDynamic.App.Widgets.Clipboard.Views.ClipboardCompactView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Height="36"
             Background="Transparent">
    <Grid Margin="12,0,12,0" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <!-- Icon Column -->
            <ColumnDefinition Width="Auto" />
            <!-- Text Content Column -->
            <ColumnDefinition Width="*" />
            <!-- RAM Badge Column -->
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Category Icon Column -->
        <Viewbox Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center" Width="16" Height="16" Stretch="Uniform">
            <Grid Width="24" Height="24">
                <!-- Text Icon -->
                <Path Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-2 10H7v-2h10v2zm0-4H7V7h10v2z"
                      Fill="#FFA855F7"
                      Stretch="Uniform"
                      Width="20"
                      Height="20">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsText}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>

                <!-- URL / Link Icon -->
                <Path Data="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z"
                      Fill="#FF38BDF8"
                      Stretch="Uniform"
                      Width="20"
                      Height="20">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUrl}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>

                <!-- Image Icon -->
                <Path Data="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"
                      Fill="#FF34D399"
                      Stretch="Uniform"
                      Width="20"
                      Height="20">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsImage}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>

                <!-- Files Icon -->
                <Path Data="M20 6h-8l-2-2H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm0 12H4V8h16v10z"
                      Fill="#FFFBBF24"
                      Stretch="Uniform"
                      Width="20"
                      Height="20">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFiles}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
            </Grid>
        </Viewbox>

        <!-- Notice Text Column -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
            <TextBlock Foreground="#FFFFFFFF"
                       FontSize="12"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="{Binding TransientTitle}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TransientSubtitle, Converter={x:Null}}" Value="">
                                <Setter Property="Text" Value="{Binding TransientTitle}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Text="{Binding TransientSubtitle}"
                       Foreground="#AAFFFFFF"
                       FontSize="10"
                       FontWeight="Normal"
                       TextTrimming="CharacterEllipsis">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TransientSubtitle}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <!-- Right: Subtle RAM indicator badge -->
        <Border Grid.Column="2"
                Background="#26A855F7"
                CornerRadius="4"
                Padding="5,1,5,2"
                VerticalAlignment="Center">
            <TextBlock Text="RAM"
                       Foreground="#D8A855F7"
                       FontSize="9"
                       FontWeight="Bold" />
        </Border>
    </Grid>
</UserControl>
