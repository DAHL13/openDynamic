<UserControl x:Class="OpenDynamic.App.Widgets.Battery.Views.BatteryExpandedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:power="clr-namespace:OpenDynamic.Core.Power;assembly=OpenDynamic.Core"
             mc:Ignorable="d" 
             Width="390"
             Height="150"
             Background="Transparent">
    <Grid Margin="20,16,20,18">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto" />
            <!-- Battery Level Visual & Percentage -->
            <RowDefinition Height="*" />
            <!-- Status Info Footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Estado de Energía"
                       Foreground="#88FFFFFF"
                       FontSize="11"
                       FontWeight="Medium" />
        </Grid>

        <!-- Center: Large Battery Bar & Big Percentage -->
        <Grid Grid.Row="1" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Large Progress Fill -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                <ProgressBar Height="14"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding Percent, Mode=OneWay}">
                    <ProgressBar.Template>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid>
                                <Border Background="#33FFFFFF"
                                        CornerRadius="7"
                                        Height="14" />
                                <Border x:Name="PART_Indicator"
                                        HorizontalAlignment="Left"
                                        CornerRadius="7"
                                        Height="14">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FFFFFFFF" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCharging}" Value="True">
                                                    <Setter Property="Background" Value="#FF22C55E" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding AlertKind}" Value="{x:Static power:BatteryAlertKind.LowBattery}">
                                                    <Setter Property="Background" Value="#FFF59E0B" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding AlertKind}" Value="{x:Static power:BatteryAlertKind.CriticalBattery}">
                                                    <Setter Property="Background" Value="#FFEF4444" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </ProgressBar.Template>
                </ProgressBar>
            </StackPanel>

            <!-- Big Percent Display -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding Percent, StringFormat='{}{0}%'}"
                           Foreground="#FFFFFFFF"
                           FontSize="28"
                           FontWeight="Bold" />
                <!-- Charging Icon -->
                <Path Data="M7 2v11h3v9l7-12h-4l4-8z"
                      Fill="#FF22C55E"
                      Stretch="Uniform"
                      Width="16"
                      Height="20"
                      Margin="8,0,0,0"
                      VerticalAlignment="Center">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCharging}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
            </StackPanel>
        </Grid>

        <!-- Footer: Status Text -->
        <Grid Grid.Row="2">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Title}"
                           Foreground="#FFFFFFFF"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0,0,6,0" />
                <TextBlock Text="•"
                           Foreground="#66FFFFFF"
                           FontSize="12"
                           Margin="0,0,6,0" />
                <TextBlock Text="{Binding Subtitle}"
                           Foreground="#FFAAAAAA"
                           FontSize="12" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
