<Window x:Class="OpenDynamic.App.Windowing.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:OpenDynamic.App.Views"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        Width="640"
        Height="240"
        Title="openDynamic Island">
    <Grid Background="{x:Null}" VerticalAlignment="Top" Margin="0,0,0,0">
        <!-- Minimal sensor strip flush with the top bezel for resting hover detection in Hidden state (AUD-005).
             Sized from RestingSensorPolicy (120x4 DIP). Hit-testing is gated by RestingSensorPolicy so it never
             captures clicks when the ambient clock is off or a fullscreen app is active. -->
        <Border x:Name="RestingSensorNotch"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Width="120"
                Height="4"
                Background="#01000000"
                Focusable="False"
                IsHitTestVisible="True" />

        <views:IslandView x:Name="IslandHostView"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Top"
                          Margin="0,0,0,0" />
    </Grid>
</Window>
