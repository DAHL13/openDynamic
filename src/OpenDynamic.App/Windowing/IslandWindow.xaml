<Window x:Class="OpenDynamic.App.Windowing.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:OpenDynamic.App.Views"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        Width="640"
        Height="240"
        Title="openDynamic Island">
    <Grid Background="{x:Null}" VerticalAlignment="Top" Margin="0,0,0,0">
        <!-- Sensor notch at Y=0 for resting hover detection in Hidden state -->
        <Border x:Name="RestingSensorNotch"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Width="240"
                Height="44"
                Background="Transparent"
                Focusable="False"
                IsHitTestVisible="True" />

        <views:IslandView x:Name="IslandHostView"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Top"
                          Margin="0,0,0,0" />
    </Grid>
</Window>
