<Window x:Class="OpenDynamic.App.Windowing.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:OpenDynamic.App.Views"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        Width="640"
        Height="240"
        Title="openDynamic Island">
    <Grid Background="{x:Null}">
        <views:IslandView x:Name="IslandHostView"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Top" />
    </Grid>
</Window>
