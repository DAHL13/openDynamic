<Window x:Class="OpenDynamic.App.Windowing.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        Width="640"
        Height="240"
        Title="openDynamic Island">
    <Grid Background="{x:Null}">
        <!-- Dynamic Island Capsule: initial compact pill (160x36 DIP) -->
        <Border x:Name="CapsuleBorder"
                Width="160"
                Height="36"
                Background="#FF000000"
                CornerRadius="18"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,8,0,0">
            <Grid />
        </Border>
    </Grid>
</Window>
