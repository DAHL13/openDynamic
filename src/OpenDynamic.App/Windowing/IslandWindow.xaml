<Window x:Class="OpenDynamic.App.Windowing.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        Width="640"
        Height="240"
        Title="openDynamic Island">
    <Grid Background="{x:Null}">
        <!-- Dynamic Island Capsule: Margin="0" ensures offset is determined solely by IslandPositionCalculator -->
        <Border x:Name="CapsuleBorder"
                Width="160"
                Height="36"
                Background="#FF000000"
                CornerRadius="18"
                ClipToBounds="True"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0"
                Cursor="Hand">
            <Grid x:Name="CapsuleContentGrid" ClipToBounds="True" />
        </Border>
    </Grid>
</Window>
