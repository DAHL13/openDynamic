<Application x:Class="OpenDynamic.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OpenDynamic.App">
    <Application.Resources>
        <!-- Accessibility and Dynamic Theme Resources (Task 5) -->
        <SolidColorBrush x:Key="AppCapsuleBackgroundBrush" Color="#FF000000" />
        <SolidColorBrush x:Key="AppBorderBrush" Color="#55FFFFFF" />
        <Thickness x:Key="AppNotchBorderThickness">1,0,1,1</Thickness>
        <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#FFAAAAAA" />
        <SolidColorBrush x:Key="AppTextMutedBrush" Color="#FF8E8E93" />
        <SolidColorBrush x:Key="AppControlBackgroundBrush" Color="#FF2C2C2E" />
        <SolidColorBrush x:Key="AppAccentBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="AppAccentTextBrush" Color="#FF000000" />
    </Application.Resources>
</Application>
