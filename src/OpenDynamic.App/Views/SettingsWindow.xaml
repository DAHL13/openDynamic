<Window x:Class="OpenDynamic.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:OpenDynamic.App.ViewModels"
        mc:Ignorable="d"
        Title="openDynamic - Ajustes"
        Height="680" Width="640"
        MinHeight="550" MinWidth="520"
        WindowStartupLocation="CenterScreen"
        Background="#131418"
        Foreground="#F0F2F5"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <Window.Resources>
        <!-- Modern ScrollViewer style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="8"/>
        </Style>

        <!-- Card container style -->
        <Style x:Key="SettingCard" TargetType="Border">
            <Setter Property="Background" Value="#1C1E24"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="BorderBrush" Value="#2A2D36"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Modern Slider style -->
        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="IsSnapToTickEnabled" Value="False"/>
            <Setter Property="Foreground" Value="#60A5FA"/>
        </Style>

        <!-- Header Label style -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#60A5FA"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- Setting title style -->
        <Style x:Key="SettingTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#F3F4F6"/>
        </Style>

        <!-- Setting description style -->
        <Style x:Key="SettingDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Value badge style -->
        <Style x:Key="ValueBadge" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#38BDF8"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Dark ComboBox Toggle Button Template -->
        <ControlTemplate x:Key="DarkComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Border x:Name="ButtonBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>
                    <Path x:Name="Arrow"
                          Grid.Column="1"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Data="M 0 0 L 4 4 L 8 0 Z"
                          Fill="#9CA3AF"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="ButtonBorder" Property="Background" Value="#2C2C2E"/>
                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#60A5FA"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="ButtonBorder" Property="Background" Value="#2C2C2E"/>
                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#38BDF8"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="#38BDF8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5"/>
                    <Setter TargetName="Arrow" Property="Opacity" Value="0.5"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Dark ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Margin="2,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1D4ED8"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#6B7280"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="Background" Value="#1C1C1E"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3B4252"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Template="{StaticResource DarkComboBoxToggleButtonTemplate}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,0,30,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="#1C1C1E"
                                            BorderBrush="#3B4252"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Margin="0,3,0,3"
                                            Padding="2">
                                        <ScrollViewer SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="50"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#6B7280"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2C2C2E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header Banner -->
        <Border Grid.Row="0" Background="#181920" BorderBrush="#252730" BorderThickness="0,0,0,1" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Capsule Icon Glyph -->
                        <Border Background="#2563EB" CornerRadius="8" Width="28" Height="16" Margin="0,0,10,0">
                            <Ellipse Fill="#FFFFFF" Width="4" Height="4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="openDynamic" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <Border Background="#2D3748" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                            <TextBlock Text="Ajustes" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Configuración en vivo de la Dynamic Island para Windows" FontSize="12" Foreground="#9CA3AF" Margin="38,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content with Tabs -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="16,12,16,0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="FontWeight" Value="Medium"/>
                    <Setter Property="Foreground" Value="#9CA3AF"/>
                    <Setter Property="Padding" Value="14,8"/>
                    <Setter Property="Margin" Value="0,0,6,0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="TabBorder" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="TabBorder" Property="Background" Value="#252834"/>
                                        <Setter Property="Foreground" Value="#38BDF8"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- TAB 1: Posición y Tamaño -->
            <TabItem Header="📐 Posición y Tamaño">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,12,12,12">
                    <StackPanel>
                        <!-- Monitor Selector -->
                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="180"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Monitor de Destino" Style="{StaticResource SettingTitle}"/>
                                    <TextBlock Text="Pantalla en la que se ancla y visualiza la cápsula flotante." Style="{StaticResource SettingDesc}"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding AvailableMonitors}"
                                          SelectedIndex="{Binding TargetMonitorIndex}"
                                          Height="32" VerticalContentAlignment="Center"
                                          Background="#1C1C1E" Foreground="#FFFFFF" BorderBrush="#3B4252"/>
                            </Grid>
                        </Border>

                        <!-- Offset X -->
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Desplazamiento Horizontal (Offset X)" Style="{StaticResource SettingTitle}"/>
                                        <TextBlock Text="Alineación horizontal respecto al centro de la pantalla." Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding OffsetX, StringFormat='{}{0:0} DIP'}" Style="{StaticResource ValueBadge}"/>
                                </Grid>
                                <Slider Minimum="-300" Maximum="300" Value="{Binding OffsetX}" SmallChange="1" LargeChange="10"/>
                            </StackPanel>
                        </Border>

                        <!-- Offset Y -->
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Margen Superior (Offset Y)" Style="{StaticResource SettingTitle}"/>
                                        <TextBlock Text="Distancia desde el marco superior de la pantalla hasta la muesca (0 DIP para anclaje al bisel)." Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding OffsetY, StringFormat='{}{0:0} DIP'}" Style="{StaticResource ValueBadge}"/>
                                </Grid>
                                <Slider Minimum="0" Maximum="80" Value="{Binding OffsetY}" SmallChange="1" LargeChange="5"/>
                            </StackPanel>
                        </Border>

                        <!-- Capsule Width -->
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Ancho Base de la Muesca (Compacto)" Style="{StaticResource SettingTitle}"/>
                                        <TextBlock Text="Ancho en reposo y modo compacto (por defecto 200 DIP)." Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding CapsuleWidth, StringFormat='{}{0:0} DIP'}" Style="{StaticResource ValueBadge}"/>
                                </Grid>
                                <Slider Minimum="120" Maximum="260" Value="{Binding CapsuleWidth}" SmallChange="2" LargeChange="10"/>
                            </StackPanel>
                        </Border>

                        <!-- Capsule Height -->
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Alto Base de la Muesca" Style="{StaticResource SettingTitle}"/>
                                        <TextBlock Text="Grosor vertical en modo compacto (por defecto 36 DIP)." Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding CapsuleHeight, StringFormat='{}{0:0} DIP'}" Style="{StaticResource ValueBadge}"/>
                                </Grid>
                                <Slider Minimum="28" Maximum="48" Value="{Binding CapsuleHeight}" SmallChange="1" LargeChange="4"/>
                            </StackPanel>
                        </Border>

                        <!-- Corner Radius -->
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Radio de Esquinas Inferiores" Style="{StaticResource SettingTitle}"/>
                                        <TextBlock Text="Curvatura elástica inferior (por defecto 14 DIP para acabado notch rectangular con borde superior plano)." Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding CapsuleCornerRadius, StringFormat='{}{0:0} DIP'}" Style="{StaticResource ValueBadge}"/>
                                </Grid>
                                <Slider Minimum="8" Maximum="24" Value="{Binding CapsuleCornerRadius}" SmallChange="1" LargeChange="2"/>
                            </StackPanel>
                        </Border>

                        <!-- Reset Position Button -->
                        <Button Content="🔄 Restablecer Posición y Dimensiones Predeterminadas"
                                Command="{Binding ResetPositionCommand}"
                                Height="34" Margin="0,4,0,12"
                                Background="#252A36" Foreground="#94A3B8" BorderBrush="#374151"
                                HorizontalAlignment="Left" Padding="14,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: Widgets y Prioridades -->
            <TabItem Header="🧩 Widgets y Prioridades">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,12,12,12">
                    <StackPanel>
                        <!-- Hardware Widget Card -->
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="📊 Monitor de Hardware (CPU y RAM)" Style="{StaticResource SettingTitle}"/>
                                        <TextBlock Text="Monitorea en tiempo real el consumo de CPU y memoria física." Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <CheckBox IsChecked="{Binding EnableHardwareMonitoring}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <StackPanel Margin="0,12,0,0">
                                    <Grid>
                                        <TextBlock Text="Prioridad de Hardware" Style="{StaticResource SettingDesc}"/>
                                        <TextBlock Text="{Binding DefaultHardwarePriority}" Style="{StaticResource ValueBadge}"/>
                                    </Grid>
                                    <Slider Minimum="5" Maximum="50" Value="{Binding DefaultHardwarePriority}" SmallChange="5"/>
                                </StackPanel>

                                <StackPanel Margin="0,8,0,0">
                                    <Grid>
                                        <TextBlock Text="Intervalo de Muestreo (Segundos)" Style="{StaticResource SettingDesc}"/>
                                        <TextBlock Text="{Binding HardwareSamplingIntervalSeconds, StringFormat='{}{0:0.0} s'}" Style="{StaticResource ValueBadge}"/>
                                    </Grid>
                                    <Slider Minimum="0.5" Maximum="5.0" Value="{Binding HardwareSamplingIntervalSeconds}" SmallChange="0.5"/>
                                </StackPanel>

                                <Grid Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Monitoreo de GPU (Experimental)" FontSize="12" Foreground="#CBD5E1"/>
                                        <TextBlock Text="Usa contadores de rendimiento de Windows (requiere más recursos)." Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <CheckBox IsChecked="{Binding EnableGpuMonitoring}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Media Widget Card -->
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="🎵 Música y Multimedia (GSMTC)" Style="{StaticResource SettingTitle}"/>
                                        <TextBlock Text="Detecta reproductores como Spotify, Edge, Chrome y VLC." Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <CheckBox IsChecked="{Binding EnableMediaWidget}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <StackPanel Margin="0,12,0,0">
                                    <Grid>
                                        <TextBlock Text="Prioridad de Música" Style="{StaticResource SettingDesc}"/>
                                        <TextBlock Text="{Binding DefaultMediaPriority}" Style="{StaticResource ValueBadge}"/>
                                    </Grid>
                                    <Slider Minimum="10" Maximum="60" Value="{Binding DefaultMediaPriority}" SmallChange="5"/>
                                </StackPanel>

                                <StackPanel Margin="0,8,0,0">
                                    <Grid>
                                        <TextBlock Text="Tiempo de Gracia tras Pausa (Segundos)" Style="{StaticResource SettingDesc}"/>
                                        <TextBlock Text="{Binding MediaPauseGracePeriodSeconds, StringFormat='{}{0} s'}" Style="{StaticResource ValueBadge}"/>
                                    </Grid>
                                    <Slider Minimum="0" Maximum="30" Value="{Binding MediaPauseGracePeriodSeconds}" SmallChange="1"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Volume Widget Card -->
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="🔊 Control de Volumen del Sistema" Style="{StaticResource SettingTitle}"/>
                                        <TextBlock Text="Aviso transitorio al cambiar el volumen con rueda o teclas de audio." Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <CheckBox IsChecked="{Binding EnableVolumeWidget}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <StackPanel Margin="0,12,0,0">
                                    <Grid>
                                        <TextBlock Text="Prioridad de Volumen" Style="{StaticResource SettingDesc}"/>
                                        <TextBlock Text="{Binding DefaultVolumePriority}" Style="{StaticResource ValueBadge}"/>
                                    </Grid>
                                    <Slider Minimum="50" Maximum="100" Value="{Binding DefaultVolumePriority}" SmallChange="5"/>
                                </StackPanel>

                                <StackPanel Margin="0,8,0,0">
                                    <Grid>
                                        <TextBlock Text="Duración del Aviso Transitorio" Style="{StaticResource SettingDesc}"/>
                                        <TextBlock Text="{Binding VolumeTransientDurationSeconds, StringFormat='{}{0:0.0} s'}" Style="{StaticResource ValueBadge}"/>
                                    </Grid>
                                    <Slider Minimum="0.5" Maximum="5.0" Value="{Binding VolumeTransientDurationSeconds}" SmallChange="0.5"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Battery Widget Card -->
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="🔋 Alertas de Batería y Cargador" Style="{StaticResource SettingTitle}"/>
                                        <TextBlock Text="Avisos instantáneos al conectar el cargador o alcanzar batería baja." Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <CheckBox IsChecked="{Binding EnableBatteryWidget}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <StackPanel Margin="0,12,0,0">
                                    <Grid>
                                        <TextBlock Text="Umbral de Batería Baja" Style="{StaticResource SettingDesc}"/>
                                        <TextBlock Text="{Binding BatteryLowThresholdPercent, StringFormat='{}{0}%'}" Style="{StaticResource ValueBadge}"/>
                                    </Grid>
                                    <Slider Minimum="15" Maximum="35" Value="{Binding BatteryLowThresholdPercent}" SmallChange="1"/>
                                </StackPanel>

                                <StackPanel Margin="0,8,0,0">
                                    <Grid>
                                        <TextBlock Text="Umbral de Batería Crítica" Style="{StaticResource SettingDesc}"/>
                                        <TextBlock Text="{Binding BatteryCriticalThresholdPercent, StringFormat='{}{0}%'}" Style="{StaticResource ValueBadge}"/>
                                    </Grid>
                                    <Slider Minimum="5" Maximum="15" Value="{Binding BatteryCriticalThresholdPercent}" SmallChange="1"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Timer Widget Card -->
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="⏱ Temporizador y Pomodoro" Style="{StaticResource SettingTitle}"/>
                                        <TextBlock Text="Cuenta regresiva sin deriva temporal y sesiones de concentración." Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <CheckBox IsChecked="{Binding EnableTimerWidget}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <StackPanel Margin="0,12,0,0">
                                    <Grid>
                                        <TextBlock Text="Duración de Trabajo Pomodoro" Style="{StaticResource SettingDesc}"/>
                                        <TextBlock Text="{Binding PomodoroWorkDurationMinutes, StringFormat='{}{0} min'}" Style="{StaticResource ValueBadge}"/>
                                    </Grid>
                                    <Slider Minimum="5" Maximum="60" Value="{Binding PomodoroWorkDurationMinutes}" SmallChange="5"/>
                                </StackPanel>

                                <StackPanel Margin="0,8,0,0">
                                    <Grid>
                                        <TextBlock Text="Duración de Descanso Pomodoro" Style="{StaticResource SettingDesc}"/>
                                        <TextBlock Text="{Binding PomodoroBreakDurationMinutes, StringFormat='{}{0} min'}" Style="{StaticResource ValueBadge}"/>
                                    </Grid>
                                    <Slider Minimum="1" Maximum="20" Value="{Binding PomodoroBreakDurationMinutes}" SmallChange="1"/>
                                </StackPanel>

                                <!-- Multi-Timer Management Section (Phase 12) -->
                                <Border Margin="0,14,0,0" Padding="0,10,0,0" BorderBrush="#22FFFFFF" BorderThickness="0,1,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Temporizadores configurados (máx. 5)" Style="{StaticResource SettingDesc}" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                        <TextBlock Text="Edita los nombres o añade nuevos. Sin robo de foco en la Dynamic Island." FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}" Margin="0,2,0,8"/>

                                        <!-- Timers List -->
                                        <ItemsControl ItemsSource="{Binding EditableTimers}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                                                                 Height="28" VerticalContentAlignment="Center"
                                                                 Padding="6,0" Margin="0,0,8,0"
                                                                 Background="#242732" Foreground="#FFFFFF" BorderBrush="#3B4252"
                                                                 AutomationProperties.Name="Etiqueta del temporizador"/>

                                                        <TextBlock Grid.Column="1" Text="{Binding DurationDisplay}"
                                                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                                                   FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}"/>

                                                        <Button Grid.Column="2" Content="✕"
                                                                Command="{Binding DataContext.DeleteCustomTimerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding Id}"
                                                                Width="24" Height="28"
                                                                Background="#3F2D2D" Foreground="#FF6B6B" BorderThickness="0"
                                                                Cursor="Hand"
                                                                AutomationProperties.Name="Eliminar temporizador"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Add Timer Row -->
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBox Text="{Binding NewTimerLabel, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="30" VerticalContentAlignment="Center"
                                                     Padding="8,0" Margin="0,0,8,0"
                                                     Background="#242732" Foreground="#FFFFFF" BorderBrush="#3B4252"
                                                     AutomationProperties.Name="Nombre del nuevo temporizador"/>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding NewTimerDurationMinutes, StringFormat='{}{0} min'}"
                                                           FontSize="11" Foreground="{DynamicResource AppTextMutedBrush}"
                                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <Slider Minimum="1" Maximum="120" Value="{Binding NewTimerDurationMinutes}" Width="90" SmallChange="1"
                                                        AutomationProperties.Name="Duración en minutos del nuevo temporizador"/>
                                            </StackPanel>

                                            <Button Grid.Column="2" Content="Crear"
                                                    Command="{Binding AddCustomTimerCommand}"
                                                    IsEnabled="{Binding CanAddNewTimer}"
                                                    Height="30" Padding="12,0"
                                                    Background="#2563EB" Foreground="#FFFFFF" BorderThickness="0"
                                                    Cursor="Hand"
                                                    AutomationProperties.Name="Crear nuevo temporizador"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Stopwatch Card (Phase 12) -->
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="⏱ Cronómetro" Style="{StaticResource SettingTitle}"/>
                                        <TextBlock Text="Cronómetro continuo con registro de vueltas (splits) y sin deriva temporal." Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <CheckBox IsChecked="{Binding EnableStopwatchWidget}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              AutomationProperties.Name="Activar widget de cronómetro"/>
                                </Grid>

                                <StackPanel Margin="0,12,0,0">
                                    <Grid>
                                        <TextBlock Text="Prioridad del Cronómetro" Style="{StaticResource SettingDesc}"/>
                                        <TextBlock Text="{Binding DefaultStopwatchPriority}" Style="{StaticResource ValueBadge}"/>
                                    </Grid>
                                    <Slider Minimum="20" Maximum="60" Value="{Binding DefaultStopwatchPriority}" SmallChange="5"
                                            AutomationProperties.Name="Prioridad del cronómetro"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Network Alerts Card (Phase 11) -->
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="🌐 Alertas de Red (Wi-Fi / Ethernet)" Style="{StaticResource SettingTitle}"/>
                                        <TextBlock Text="Avisos transitorios al conectarse, desconectarse o cambiar de red Wi-Fi o cableada." Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <CheckBox IsChecked="{Binding EnableNetworkAlerts}"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"
                                              AutomationProperties.Name="Activar alertas de red"/>
                                </Grid>

                                <StackPanel Margin="0,12,0,0">
                                    <Grid>
                                        <TextBlock Text="Prioridad de Red" Style="{StaticResource SettingDesc}"/>
                                        <TextBlock Text="{Binding DefaultNetworkPriority}" Style="{StaticResource ValueBadge}"/>
                                    </Grid>
                                    <Slider Minimum="40" Maximum="80" Value="{Binding DefaultNetworkPriority}" SmallChange="5"
                                            AutomationProperties.Name="Prioridad de alertas de red"/>
                                </StackPanel>

                                <StackPanel Margin="0,8,0,0">
                                    <Grid>
                                        <TextBlock Text="Duración del Aviso Transitorio" Style="{StaticResource SettingDesc}"/>
                                        <TextBlock Text="{Binding NetworkTransientDurationSeconds, StringFormat='{}{0:0.0} s'}" Style="{StaticResource ValueBadge}"/>
                                    </Grid>
                                    <Slider Minimum="1.0" Maximum="10.0" Value="{Binding NetworkTransientDurationSeconds}" SmallChange="0.5"
                                            AutomationProperties.Name="Duración del aviso transitorio de red"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Device Alerts Card (Phase 11) -->
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="🔌 Dispositivos USB y Bluetooth" Style="{StaticResource SettingTitle}"/>
                                        <TextBlock Text="Avisos instantáneos al conectar o desconectar unidades USB, auriculares, ratones o teclados Bluetooth." Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <CheckBox IsChecked="{Binding EnableDeviceAlerts}"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"
                                              AutomationProperties.Name="Activar alertas de dispositivos"/>
                                </Grid>

                                <StackPanel Margin="0,12,0,0">
                                    <Grid>
                                        <TextBlock Text="Prioridad de Dispositivos" Style="{StaticResource SettingDesc}"/>
                                        <TextBlock Text="{Binding DefaultDevicePriority}" Style="{StaticResource ValueBadge}"/>
                                    </Grid>
                                    <Slider Minimum="30" Maximum="75" Value="{Binding DefaultDevicePriority}" SmallChange="5"
                                            AutomationProperties.Name="Prioridad de alertas de dispositivos"/>
                                </StackPanel>

                                <StackPanel Margin="0,8,0,0">
                                    <Grid>
                                        <TextBlock Text="Duración del Aviso Transitorio" Style="{StaticResource SettingDesc}"/>
                                        <TextBlock Text="{Binding DeviceTransientDurationSeconds, StringFormat='{}{0:0.0} s'}" Style="{StaticResource ValueBadge}"/>
                                    </Grid>
                                    <Slider Minimum="1.0" Maximum="10.0" Value="{Binding DeviceTransientDurationSeconds}" SmallChange="0.5"
                                            AutomationProperties.Name="Duración del aviso transitorio de dispositivos"/>
                                </StackPanel>

                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock Text="Dispositivos Ignorados" FontSize="12.5" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                                    <TextBlock Text="No se emitirán notificaciones para los dispositivos cuyos nombres coincidan con esta lista." Style="{StaticResource SettingDesc}"/>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding NewIgnoredDeviceName, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="30" VerticalContentAlignment="Center"
                                                 Padding="8,0" Margin="0,0,8,0"
                                                 Background="#242732" Foreground="#FFFFFF" BorderBrush="#3B4252"
                                                 AutomationProperties.Name="Nombre de dispositivo a ignorar"/>
                                        <Button Grid.Column="1" Content="Añadir"
                                                Command="{Binding AddIgnoredDeviceCommand}"
                                                Height="30" Padding="14,0"
                                                Background="#2563EB" Foreground="#FFFFFF" BorderThickness="0"
                                                AutomationProperties.Name="Añadir dispositivo a lista de ignorados"/>
                                    </Grid>

                                    <ListBox ItemsSource="{Binding IgnoredDeviceNames}"
                                             SelectedItem="{Binding SelectedIgnoredDevice}"
                                             Height="80" Margin="0,8,0,0"
                                             Background="#181A20" Foreground="#F0F2F5" BorderBrush="#2A2D36"
                                             AutomationProperties.Name="Lista de dispositivos ignorados"/>

                                    <Button Content="Eliminar Seleccionado"
                                            Command="{Binding RemoveIgnoredDeviceCommand}"
                                            CommandParameter="{Binding SelectedIgnoredDevice}"
                                            Height="28" Margin="0,6,0,0" Padding="10,0"
                                            Background="#252A36" Foreground="#EF4444" BorderBrush="#374151"
                                            HorizontalAlignment="Left"
                                            AutomationProperties.Name="Eliminar dispositivo seleccionado"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: Atajos y Sistema -->
            <TabItem Header="⚡ Atajos y Sistema">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,12,12,12">
                    <StackPanel>
                        <!-- Global Hotkey Card -->
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock Text="⌨ Atajo Global de Teclado" Style="{StaticResource SettingTitle}"/>
                                <TextBlock Text="Combinación global para mostrar u ocultar la isla flotante (Win32 RegisterHotKey, sin hooks de bajo nivel)." Style="{StaticResource SettingDesc}"/>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding ToggleIslandHotkey, UpdateSourceTrigger=LostFocus}"
                                             Height="32" VerticalContentAlignment="Center"
                                             Padding="8,0"
                                             Background="#242732" Foreground="#FFFFFF" BorderBrush="#3B4252"
                                             FontSize="13"/>
                                    <Button Grid.Column="1" Content="Aplicar Atajo"
                                            Command="{Binding ApplyHotkeyCommand}"
                                            Height="32" Margin="8,0,0,0" Padding="14,0"
                                            Background="#2563EB" Foreground="#FFFFFF" BorderThickness="0"/>
                                </Grid>

                                <!-- Conflict Alert Badge -->
                                <Border Background="#451A1A" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="6"
                                        Padding="10,8" Margin="0,10,0,0"
                                        Visibility="{Binding HasHotkeyConflict, Converter={x:Static viewModels:SettingsConverters.BooleanToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚠️ " Foreground="#EF4444" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding HotkeyConflictMessage}" Foreground="#FCA5A5" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Motion and Animations (Phase 10 Accessibility) -->
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="220"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="🎬 Animaciones y Movimiento (Accesibilidad)" Style="{StaticResource SettingTitle}"/>
                                        <TextBlock Text="Configura el comportamiento elástico o directo de la cápsula según tus preferencias de movimiento." Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding MotionModeOptions}"
                                              SelectedItem="{Binding SelectedMotionModeOption}"
                                              DisplayMemberPath="DisplayName"
                                              Height="32" VerticalContentAlignment="Center"
                                              Background="#1C1C1E" Foreground="#FFFFFF" BorderBrush="#3B4252"
                                              AutomationProperties.Name="Modo de animaciones y movimiento"/>
                                </Grid>
                                <Border Background="#1E232F" BorderBrush="#374151" BorderThickness="1" CornerRadius="6"
                                        Padding="10,8" Margin="0,10,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="ℹ️ " Foreground="#38BDF8" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding SystemAnimationStatusText}" Foreground="#94A3B8" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                                                   AutomationProperties.Name="Estado de animaciones del sistema"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Fullscreen Behavior Card -->
                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="🖥 Ocultar en Pantalla Completa" Style="{StaticResource SettingTitle}"/>
                                    <TextBlock Text="Suspende automáticamente la isla al jugar o ver videos maximizados (0% CPU)." Style="{StaticResource SettingDesc}"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" IsChecked="{Binding HideOnFullscreen}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Autostart Card -->
                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="🚀 Iniciar con Windows" Style="{StaticResource SettingTitle}"/>
                                    <TextBlock Text="Arranca openDynamic al iniciar sesión en Windows (sin elevación de permisos UAC)." Style="{StaticResource SettingDesc}"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" IsChecked="{Binding StartWithWindows}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Factory Reset Card -->
                        <Border Style="{StaticResource SettingCard}">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Restablecer Configuración de Fábrica" Style="{StaticResource SettingTitle}"/>
                                    <TextBlock Text="Vuelve a los valores predeterminados de fábrica para todos los parámetros." Style="{StaticResource SettingDesc}"/>
                                </StackPanel>
                                <Button Content="Restablecer Todo"
                                        Command="{Binding ResetAllDefaultsCommand}"
                                        Height="32" Padding="14,0"
                                        Background="#7F1D1D" Foreground="#FCA5A5" BorderBrush="#991B1B"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Bottom Footer -->
        <Border Grid.Row="2" Background="#181920" BorderBrush="#252730" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <TextBlock Text="openDynamic • Hito M5 (Bandeja, Ajustes y Atajos)" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center"/>
                <Button Content="Cerrar" Click="OnCloseClicked"
                        HorizontalAlignment="Right"
                        Height="32" Padding="20,0"
                        Background="#2B303C" Foreground="#E2E8F0" BorderBrush="#3B4252"/>
            </Grid>
        </Border>
    </Grid>
</Window>
